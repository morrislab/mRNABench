---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-intro">
  <div class="shell page-intro__grid">
    <div class="page-intro__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-intro__lead">{lead}</p>
    </div>
  </div>
</header>

<style>
  .page-intro {
    padding: clamp(3.5rem, 6vw, 5.5rem) 0 clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .page-intro__grid {
    display: block;
  }

  .page-intro__copy {
    max-width: 74rem;
  }

  h1 {
    max-width: 24ch;
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 4.2rem);
    font-weight: 520;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .page-intro__lead {
    max-width: 44rem;
    margin: clamp(1.3rem, 3vw, 2rem) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

</style>
