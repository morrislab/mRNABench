---
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
}

const { eyebrow, title, lead } = Astro.props;
---

<header class="page-intro">
  <div class="shell page-intro__grid">
    <div class="page-intro__copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="page-intro__lead">{lead}</p>
    </div>
  </div>
</header>

<style>
  .page-intro {
    padding: clamp(2.8rem, 5vw, 4.2rem) 0 clamp(2.2rem, 4vw, 3.2rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .page-intro__grid {
    display: block;
  }

  .page-intro__copy {
    max-width: 64rem;
  }

  h1 {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .page-intro__lead {
    max-width: 50rem;
    margin: clamp(1rem, 2vw, 1.4rem) 0 0;
    color: var(--ink-muted);
    font-size: var(--text-base);
    line-height: 1.55;
  }

</style>
