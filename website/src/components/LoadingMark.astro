---
interface Props {
  label?: string;
  size?: "small" | "large";
}

const { label = "Loading benchmark results", size = "large" } = Astro.props;
---

<div class:list={["loading-mark", `loading-mark--${size}`]} data-loading-mark role="status">
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <path data-loader-stem d="M34 71V129"></path>
    <path data-loader-stem d="M56 43V76"></path>
    <path class="loading-mark__red" data-loader-stem d="M56 86V114"></path>
    <path data-loader-stem d="M56 124V157"></path>
    <path data-loader-stem d="M78 31V66"></path>
    <path data-loader-stem d="M78 76V124"></path>
    <path class="loading-mark__red" data-loader-stem d="M78 134V169"></path>
    <path data-loader-stem d="M100 28V64"></path>
    <path class="loading-mark__red" data-loader-stem d="M100 74V126"></path>
    <path data-loader-stem d="M100 136V172"></path>
    <path data-loader-stem d="M122 31V66"></path>
    <path data-loader-stem d="M122 76V124"></path>
    <path data-loader-stem d="M122 134V169"></path>
    <path class="loading-mark__red" data-loader-stem d="M144 43V76"></path>
    <path data-loader-stem d="M144 86V114"></path>
    <path data-loader-stem d="M144 124V157"></path>
    <path data-loader-stem d="M166 71V129"></path>
  </svg>
  <span>{label}</span>
</div>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const activeAnimations = new Set<Animation>();
  let motionCycle = 0;
  const wait = (milliseconds: number) =>
    new Promise((resolve) => window.setTimeout(resolve, milliseconds));

  async function pulse(stem: SVGPathElement, loader: HTMLElement, cycle: number) {
    await wait(120 + Math.random() * 1300);

    while (
      stem.isConnected &&
      !loader.hidden &&
      !reduceMotion.matches &&
      cycle === motionCycle
    ) {
      const duration = 1400 + Math.random() * 1400;
      const floor = 0.1 + Math.random() * 0.16;
      const peak = 0.72 + Math.random() * 0.28;
      const lift = 0.5 + Math.random() * 1.5;
      const animation = stem.animate(
        [
          {
            opacity: floor,
            transform: "translateY(0) scaleY(0.94)",
            offset: 0,
          },
          {
            opacity: peak,
            transform: `translateY(-${lift}px) scaleY(1.045)`,
            offset: 0.46,
          },
          {
            opacity: floor,
            transform: "translateY(0) scaleY(0.96)",
            offset: 1,
          },
        ],
        {
          duration,
          easing: "cubic-bezier(0.37, 0, 0.63, 1)",
        },
      );

      activeAnimations.add(animation);
      try {
        await animation.finished;
      } catch (error) {
        if (!reduceMotion.matches && cycle === motionCycle) {
          console.warn("A loading-mark animation stopped unexpectedly.", error);
        }
        return;
      } finally {
        activeAnimations.delete(animation);
      }
      await wait(90 + Math.random() * 620);
    }
  }

  function initializeLoadingMarks() {
    motionCycle += 1;
    const cycle = motionCycle;
    activeAnimations.forEach((animation) => animation.cancel());
    activeAnimations.clear();
    if (reduceMotion.matches) return;

    document.querySelectorAll<HTMLElement>("[data-loading-mark]").forEach((loader) => {
      if (loader.closest("[hidden]")) return;
      loader.querySelectorAll<SVGPathElement>("[data-loader-stem]").forEach((stem) => {
        void pulse(stem, loader, cycle);
      });
    });
  }

  reduceMotion.addEventListener("change", initializeLoadingMarks);
  document.addEventListener("mrnabench:loading-change", initializeLoadingMarks);
  initializeLoadingMarks();
</script>

<style>
  .loading-mark {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
    color: var(--ink);
  }

  .loading-mark svg {
    width: 5.5rem;
    height: 5.5rem;
    overflow: visible;
  }

  .loading-mark--small svg {
    width: 2.6rem;
    height: 2.6rem;
  }

  .loading-mark path {
    fill: none;
    opacity: 0.2;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 12;
    transform-box: fill-box;
    transform-origin: center;
  }

  .loading-mark path.loading-mark__red {
    stroke: var(--red);
  }

  .loading-mark span {
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-mark path {
      opacity: 0.78;
      transform: none;
    }
  }
</style>
