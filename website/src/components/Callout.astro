---
interface Props {
  label?: string;
  tone?: "note" | "important";
}

const { tone = "note" } = Astro.props;
const label = Astro.props.label ?? (tone === "important" ? "Important" : "Note");
---

<aside class:list={["callout", `callout--${tone}`]} role="note">
  <strong>{label}</strong>
  <div><slot /></div>
</aside>

<style>
  .callout {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem;
    margin: 2rem 0;
    padding: 1.15rem 1.25rem;
    background: var(--paper-soft);
    border-top: 2px solid var(--line-strong);
  }

  .callout--important {
    border-color: var(--red);
  }

  strong {
    color: var(--ink);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .callout :global(p) {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  @media (max-width: 520px) {
    .callout {
      grid-template-columns: 1fr;
      gap: 0.45rem;
    }
  }
</style>
