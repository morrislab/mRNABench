---
import { withBase } from "../lib/site";

interface Props {
  compact?: boolean;
  onDark?: boolean;
}

const { compact = false, onDark = false } = Astro.props;
---

<a class:list={["logo", { "logo--compact": compact, "logo--on-dark": onDark }]} href={withBase("/")} aria-label="mRNABench home">
  <svg class="logo__mark" viewBox="0 0 200 200" aria-hidden="true">
    <path d="M40 68V132"></path>
    <path class="logo__red" d="M70 36V92"></path>
    <path d="M70 108V164"></path>
    <path d="M100 28V92"></path>
    <path class="logo__red" d="M100 108V172"></path>
    <path class="logo__red" d="M130 36V92"></path>
    <path d="M130 108V164"></path>
    <path d="M160 68V132"></path>
  </svg>
  <span class="logo__wordmark">
    m<span>RNA</span>Bench
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.62rem;
    color: var(--ink);
    text-decoration: none;
  }

  .logo__mark {
    width: 2.15rem;
    height: 2.15rem;
    flex: none;
    overflow: visible;
  }

  .logo__mark path {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 18;
  }

  .logo__mark .logo__red {
    stroke: var(--red);
  }

  .logo__wordmark {
    font-size: 1.16rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .logo__wordmark span {
    color: var(--red);
  }

  .logo--on-dark .logo__red {
    stroke: var(--red-on-dark);
  }

  .logo--on-dark .logo__wordmark span {
    color: var(--red-on-dark);
  }

  .logo--compact .logo__wordmark {
    display: none;
  }
</style>
