---
import { site, withBase } from "../lib/site";
import Logo from "./Logo.astro";
---

<footer class="site-footer">
  <div class="shell">
    <div class="site-footer__top">
      <div>
        <Logo onDark />
        <p>Benchmarking frozen nucleotide-model representations on mature mRNA tasks.</p>
      </div>
      <div class="site-footer__links">
        <div>
          <span>Benchmark</span>
          <a href={withBase("/overview")}>Paper overview</a>
          <a href={withBase("/leaderboard")}>Leaderboard</a>
          <a href={withBase("/datasets")}>Dataset catalog</a>
          <a href={withBase("/models")}>Model catalog</a>
        </div>
        <div>
          <span>Software</span>
          <a href={withBase("/docs")}>Documentation</a>
          <a href={withBase("/docs/quickstart")}>Quickstart</a>
          <a href={site.repository}>Source code</a>
        </div>
      </div>
    </div>
    <div class="site-footer__bottom">
      <span>mRNABench is released under the AGPL-3.0 license.</span>
      <span>Weill Cornell Medicine and the University of Toronto</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding: 5rem 0 1.5rem;
    background: var(--black);
    color: var(--white);
  }

  .site-footer :global(.logo) {
    color: var(--white);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 4rem;
    padding-bottom: 4.5rem;
  }

  .site-footer__top p {
    max-width: 24rem;
    margin: 1.1rem 0 0;
    color: var(--footer-muted);
    font-size: var(--text-sm);
  }

  .site-footer__links {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .site-footer__links > div {
    display: grid;
    align-content: start;
    gap: 0.72rem;
  }

  .site-footer__links span {
    margin-bottom: 0.3rem;
    color: var(--footer-muted);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .site-footer__links a {
    width: fit-content;
    color: var(--white);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .site-footer__links a:hover {
    color: var(--red-on-dark);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 1.3rem;
    color: var(--footer-muted);
    border-top: 1px solid var(--footer-line);
    font-size: var(--text-xs);
  }

  @media (max-width: 700px) {
    .site-footer__top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .site-footer__bottom {
      display: grid;
    }
  }
</style>
