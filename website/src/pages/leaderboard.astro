---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { withBase } from "../lib/site";
import leaderboardConfig from "../../leaderboard.config.json";

const datasetExclusions = Object.entries(leaderboardConfig.excluded_datasets);
const modelExclusions = Object.entries(leaderboardConfig.excluded_models);
---

<BaseLayout
  title="Leaderboard | mRNABench"
  description="Compare mRNA model results across prediction tasks and datasets."
>
  <PageIntro
    eyebrow="Benchmark results"
    title="Leaderboard"
    lead="Rank models across the included datasets using each dataset's default split. Switch between consensus, prediction-task, and dataset views."
  />

  <section class="leaderboard-intro shell">
    <details class="leaderboard-exclusions">
      <summary>Excluded datasets and reference models</summary>
      <div>
        <section>
          <h2>Datasets not included in these results</h2>
          <ul>
            {datasetExclusions.map(([id, reason]) => <li><code>{id}</code><span>{reason}</span></li>)}
          </ul>
        </section>
        <section>
          <h2>Results kept outside the model rank</h2>
          <ul>
            {modelExclusions.map(([id, reason]) => <li><code>{id}</code><span>{reason}</span></li>)}
          </ul>
        </section>
      </div>
    </details>
    <dl class="leaderboard-facts">
      <div><dt>Consensus-ranked</dt><dd data-model-count>--</dd></div>
      <div><dt>Models with results</dt><dd data-total-model-count>--</dd></div>
      <div><dt>Included datasets</dt><dd data-dataset-count>--</dd></div>
      <div><dt>Result units</dt><dd data-result-count>--</dd></div>
    </dl>
  </section>

  <section
    class="leaderboard-app shell"
    id="results"
    data-leaderboard
    data-endpoint={withBase("/data/leaderboard.json")}
  >
    <div class="leaderboard-toolbar">
      <label>
        <span>Ranking view</span>
        <select data-ranking-view disabled>
          <option value="consensus">Consensus</option>
          <option value="classification">Classification</option>
          <option value="multilabel">Multilabel</option>
          <option value="regression">Regression</option>
        </select>
      </label>
      <label>
        <span>Find a model</span>
        <input type="search" data-model-search placeholder="Model or family" disabled />
      </label>
      <a class="download-link" href={withBase("/data/leaderboard-results.csv")} download>
        Download result units
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 2V11M4.5 7.5L8 11L11.5 7.5M2 14H14"></path>
        </svg>
      </a>
    </div>

    <div
      class="leaderboard-status"
      data-loading-container
      role="status"
      aria-live="polite"
    >
      <span aria-hidden="true"></span>
      <strong>Loading leaderboard</strong>
    </div>
    <noscript>
      <style>[data-loading-container] { display: none; }</style>
      <p class="leaderboard-error">
        The interactive ranking needs JavaScript. Download the result-unit CSV
        above to inspect the results without it.
      </p>
    </noscript>
    <p class="leaderboard-error" data-leaderboard-error role="alert" hidden></p>
    <button class="leaderboard-retry" type="button" data-leaderboard-retry hidden>Retry loading results</button>

    <div class="leaderboard-output" data-leaderboard-output hidden>
      <div class="leaderboard-output__heading">
        <div>
          <p data-view-kicker>Complete coverage</p>
          <h2 id="leaderboard-view-title" data-view-title>Consensus ranking</h2>
        </div>
        <p data-view-description>
          Sum of the three biological-task ranks. Lower is better.
        </p>
      </div>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Leaderboard results table">
        <table aria-labelledby="leaderboard-view-title">
          <thead data-leaderboard-head></thead>
          <tbody data-leaderboard-body></tbody>
        </table>
      </div>
      <p class="empty-state" data-empty-state role="status" aria-live="polite" hidden>No models match that search.</p>
    </div>

    <dialog class="model-detail" data-model-detail aria-labelledby="model-detail-title">
      <button type="button" data-close-detail aria-label="Close model details">Close</button>
      <div data-model-detail-content></div>
    </dialog>
  </section>

  <section class="leaderboard-method section">
    <div class="shell">
      <div class="leaderboard-method__heading">
        <p class="eyebrow">How ranking works</p>
        <h2>From split seeds to consensus rank</h2>
      </div>
      <ol>
        <li>
          <span>01</span>
          <h3>Aggregate seeds</h3>
          <p>Mean, sample standard deviation, and Student-t 95% interval across split seeds within one model, dataset, target, split, and metric.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Rank within a target</h3>
          <p>Within each dataset, target, split, and metric, model ranks are converted to percentiles from 0 to 100.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Balance source datasets</h3>
          <p>Targets are averaged within registered dataset IDs, then related IDs from one source study are averaged before task ranking.</p>
        </li>
        <li>
          <span>04</span>
          <h3>Require coverage</h3>
          <p>The consensus includes only models with complete classification, multilabel, and regression coverage.</p>
        </li>
      </ol>
      <p class="leaderboard-method__note">
        Raw AUPRC and Pearson correlation are never averaged together. The
        consensus is a sum of task ranks, not an absolute measure of biological
        quality. A lower worst-task rank breaks a rank-sum tie; models tied on
        both values share a consensus rank. Regression uses cross-validated
        Ridge results. Replacing the source artifact can change every relative
        rank.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  interface TaskRank {
    rank: number | null;
    model_id: string;
    model_family: string;
    score: number;
    coverage_ratio: number;
    dataset_count: number;
    expected_datasets: number;
    source_group_count: number;
    expected_source_groups: number;
    rank_eligible: boolean;
  }

  interface ConsensusRank {
    rank: number;
    model_id: string;
    model_family: string;
    rank_sum: number;
    worst_task_rank: number;
    task_ranks: Record<string, number>;
    task_scores: Record<string, number>;
    coverage_ratio: number;
  }

  interface DatasetRank {
    rank: number | null;
    model_id: string;
    model_family: string;
    score: number;
    raw_mean: number;
    metric_id: string;
    coverage_ratio: number;
    target_count: number;
    expected_targets: number;
    rank_eligible: boolean;
  }

  interface ResultUnit {
    model_id: string;
    dataset_id: string;
    result_release_id: string;
    target_col: string;
    result_task: string;
    evaluation_method: string;
    estimator: string;
    split_type: string;
    metric_id: string;
    mean: number;
    ci95_low: number | null;
    ci95_high: number | null;
    n_runs: number;
    expected_runs: number;
    data_status: string;
  }

  interface DatasetInfo {
    id: string;
    label: string;
    biological_task: string;
    task_label: string;
    metric_id: string;
    target_count: number;
    source_group: string;
    split_type: string;
  }

  interface LeaderboardData {
    source: {
      label: string;
      artifact: string;
      artifact_sha256: string;
      package_commit: string | null;
    };
    row_stats: {
      retained_seed_rows: number;
      resolved_legacy_collision_rows: number;
      material_legacy_collision_keys: number;
      max_legacy_collision_difference: number;
    };
    datasets: DatasetInfo[];
    models: Array<{ id: string; family: string }>;
    rankings: {
      consensus: ConsensusRank[];
      classification: TaskRank[];
      multilabel: TaskRank[];
      regression: TaskRank[];
    };
    dataset_rankings: Record<string, DatasetRank[]>;
    results: ResultUnit[];
  }

  type RankingRow = ConsensusRank | TaskRank | DatasetRank;

  const taskLabels: Record<string, string> = {
    classification: "Classification",
    multilabel: "Multilabel",
    regression: "Regression",
  };

  const metricLabels: Record<string, string> = {
    auprc: "AUPRC",
    auprc_micro: "micro-AUPRC",
    pearson_r: "Pearson r",
  };

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[character] ?? character,
    );

  const percent = (value: number) => `${(value * 100).toFixed(1)}`;
  const metric = (value: number | null) => (
    value == null ? "Not estimable" : value.toFixed(3)
  );
  const interval = (low: number | null, high: number | null) => (
    low == null || high == null
      ? "Not estimable"
      : `[${metric(low)}, ${metric(high)}]`
  );
  const rankLabel = (
    rank: number | null,
    coverageRatio: number,
  ) => {
    if (rank != null) return `#${rank}`;
    return coverageRatio < 1
      ? "Not ranked: incomplete targets"
      : "Not ranked: incomplete seed runs";
  };

  function initializeLeaderboard() {
    const app = document.querySelector<HTMLElement>("[data-leaderboard]");
    if (!app || app.dataset.initialized === "true") return;
    app.dataset.initialized = "true";

    const endpoint = app.dataset.endpoint;
    const viewSelect = app.querySelector<HTMLSelectElement>("[data-ranking-view]");
    const search = app.querySelector<HTMLInputElement>("[data-model-search]");
    const loader = app.querySelector<HTMLElement>("[data-loading-container]");
    const output = app.querySelector<HTMLElement>("[data-leaderboard-output]");
    const error = app.querySelector<HTMLElement>("[data-leaderboard-error]");
    const retry = app.querySelector<HTMLButtonElement>("[data-leaderboard-retry]");
    const head = app.querySelector<HTMLElement>("[data-leaderboard-head]");
    const body = app.querySelector<HTMLElement>("[data-leaderboard-body]");
    const empty = app.querySelector<HTMLElement>("[data-empty-state]");
    const kicker = app.querySelector<HTMLElement>("[data-view-kicker]");
    const title = app.querySelector<HTMLElement>("[data-view-title]");
    const description = app.querySelector<HTMLElement>("[data-view-description]");
    const detail = app.querySelector<HTMLDialogElement>("[data-model-detail]");
    const detailContent = app.querySelector<HTMLElement>("[data-model-detail-content]");
    const closeDetail = app.querySelector<HTMLButtonElement>("[data-close-detail]");

    if (
      !endpoint ||
      !viewSelect ||
      !search ||
      !loader ||
      !output ||
      !error ||
      !retry ||
      !head ||
      !body ||
      !empty ||
      !kicker ||
      !title ||
      !description ||
      !detail ||
      !detailContent ||
      !closeDetail
    ) {
      return;
    }

    let data: LeaderboardData;

    const selectedDataset = () => {
      const value = viewSelect.value;
      if (!value.startsWith("dataset:")) return null;
      return data.datasets.find((dataset) => `dataset:${dataset.id}` === value) ?? null;
    };

    const getRows = (): RankingRow[] => {
      const dataset = selectedDataset();
      if (dataset) return data.dataset_rankings[dataset.id] ?? [];
      return data.rankings[viewSelect.value as keyof LeaderboardData["rankings"]] ?? [];
    };

    const renderDetail = (modelId: string) => {
      const model = data.models.find((item) => item.id === modelId);
      const consensus = data.rankings.consensus.find((item) => item.model_id === modelId);
      const datasetRows = data.datasets
        .map((dataset) => {
          const row = data.dataset_rankings[dataset.id]?.find(
            (entry) => entry.model_id === modelId,
          );
          return row ? { dataset, row } : null;
        })
        .filter(
          (item): item is { dataset: DatasetInfo; row: DatasetRank } => item !== null,
        );

      const taskRankMarkup = ["classification", "multilabel", "regression"]
        .map((task) => {
          const row = data.rankings[task as keyof LeaderboardData["rankings"]]
            .find((entry) => entry.model_id === modelId) as TaskRank | undefined;
          const rank = row
            ? rankLabel(row.rank, row.coverage_ratio)
            : "No results";
          return `<div><span>${taskLabels[task]}</span><strong>${rank}</strong></div>`;
        })
        .join("");

      const datasetMarkup = datasetRows
        .map(({ dataset, row }) => {
          const rank = rankLabel(row.rank, row.coverage_ratio);
          return `<tr>
            <td>${escapeHtml(dataset.label)}</td>
            <td>${escapeHtml(metricLabels[row.metric_id] ?? row.metric_id)}</td>
            <td>${metric(row.raw_mean)}</td>
            <td>${percent(row.score)}</td>
            <td>${rank}</td>
          </tr>`;
        })
        .join("");
      const unitMarkup = data.results
        .filter((unit) => unit.model_id === modelId)
        .map((unit) => {
          const dataset = data.datasets.find((item) => item.id === unit.dataset_id);
          return `<tr>
            <td>${escapeHtml(dataset?.label ?? unit.dataset_id)}</td>
            <td><code>${escapeHtml(unit.target_col)}</code></td>
            <td>${escapeHtml(metricLabels[unit.metric_id] ?? unit.metric_id)}</td>
            <td>${metric(unit.mean)}</td>
            <td>${interval(unit.ci95_low, unit.ci95_high)}</td>
            <td>${escapeHtml(unit.evaluation_method)} / ${escapeHtml(unit.estimator)}</td>
            <td>${escapeHtml(unit.split_type)}</td>
            <td>${unit.n_runs}/${unit.expected_runs}</td>
          </tr>`;
        })
        .join("");

      detailContent.innerHTML = `
        <p class="model-detail__eyebrow">Model detail</p>
        <h2 id="model-detail-title">${escapeHtml(modelId)}</h2>
        <p class="model-detail__family">${escapeHtml(model?.family ?? "")}</p>
        <div class="model-detail__ranks">
          ${taskRankMarkup}
        </div>
        <p class="model-detail__summary">${
          consensus
            ? `Consensus #${consensus.rank}, with a task-rank sum of ${consensus.rank_sum}.`
            : "Incomplete task coverage; no consensus rank is assigned."
        }</p>
        <div class="model-detail__table" tabindex="0" role="region" aria-label="Dataset summary table">
          <table aria-label="Dataset summary">
            <thead><tr><th>Dataset</th><th>Metric</th><th>Mean</th><th>Relative</th><th>Rank</th></tr></thead>
            <tbody>${datasetMarkup}</tbody>
          </table>
        </div>
        <h3 class="model-detail__unit-heading">Target-level result units</h3>
        <div class="model-detail__table" tabindex="0" role="region" aria-label="Target-level result table">
          <table aria-label="Target-level result units">
            <thead><tr><th>Dataset</th><th>Target</th><th>Metric</th><th>Mean</th><th>95% CI</th><th>Evaluator / estimator</th><th>Split</th><th>Runs</th></tr></thead>
            <tbody>${unitMarkup}</tbody>
          </table>
        </div>
      `;
      detail.showModal();
      closeDetail.focus();
    };

    const render = () => {
      const dataset = selectedDataset();
      const query = search.value.trim().toLowerCase();
      const rows = getRows().filter((row) =>
        `${row.model_id} ${row.model_family}`.toLowerCase().includes(query),
      );

      if (dataset) {
        kicker.textContent = dataset.task_label;
        title.textContent = dataset.label;
        description.textContent = `${metricLabels[dataset.metric_id] ?? dataset.metric_id} on the ${dataset.split_type} split, averaged over ${dataset.target_count} target${dataset.target_count === 1 ? "" : "s"}. Relative score is the mean within-target percentile.`;
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Mean metric</th><th>Relative</th><th>Target coverage</th>
        </tr>`;
      } else if (viewSelect.value === "consensus") {
        kicker.textContent = "Complete coverage";
        title.textContent = "Consensus ranking";
        description.textContent =
          "Sum of classification, multilabel, and regression ranks. Lower is better.";
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Task ranks</th><th>Rank sum</th><th>Target coverage</th>
        </tr>`;
      } else {
        const task = viewSelect.value;
        kicker.textContent = "Prediction task";
        title.textContent = `${taskLabels[task]} ranking`;
        description.textContent =
          "Mean of source-group-balanced target percentiles. Higher is better.";
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Relative score</th><th>Source groups</th><th>Target coverage</th>
        </tr>`;
      }

      body.innerHTML = rows
        .map((row) => {
          const rankReason = (
            row.rank == null
              ? row.coverage_ratio < 1
                ? "Incomplete target coverage"
                : "Incomplete seed coverage"
              : ""
          );
          const rank = row.rank == null ? "NR" : String(row.rank);
          const coverageNote = rankReason
            ? `<small>${rankReason}</small>`
            : "";
          const eligible = "rank_eligible" in row ? row.rank_eligible : true;
          const coverage = percent(row.coverage_ratio);
          let middleCells = "";

          if ("rank_sum" in row) {
            middleCells = `<td class="task-ranks">
                <span>C ${row.task_ranks.classification}</span>
                <span>M ${row.task_ranks.multilabel}</span>
                <span>R ${row.task_ranks.regression}</span>
              </td>
              <td class="numeric">${row.rank_sum}</td>`;
          } else if ("raw_mean" in row) {
            middleCells = `<td class="numeric">${metric(row.raw_mean)}</td>
              <td class="score-cell"><i style="--score:${row.score}"></i><span>${percent(row.score)}</span></td>`;
          } else {
            middleCells = `<td class="score-cell"><i style="--score:${row.score}"></i><span>${percent(row.score)}</span></td>
              <td class="numeric">${row.source_group_count}/${row.expected_source_groups}</td>`;
          }

          return `<tr data-rank="${rank}" data-eligible="${eligible}">
            <td class="rank">${rank}</td>
            <td><button class="model-button" type="button" data-model-id="${escapeHtml(row.model_id)}">${escapeHtml(row.model_id)}</button></td>
            <td class="family">${escapeHtml(row.model_family)}</td>
            ${middleCells}
            <td class="coverage">${coverage}%${coverageNote}</td>
          </tr>`;
        })
        .join("");

      empty.hidden = rows.length !== 0;
      body.querySelectorAll<HTMLButtonElement>("[data-model-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const modelId = button.dataset.modelId;
          if (modelId) renderDetail(modelId);
        });
      });
    };

    const requestController = new AbortController();
    const requestTimeout = window.setTimeout(
      () => requestController.abort(),
      30_000,
    );
    fetch(endpoint, { signal: requestController.signal })
      .then((response) => {
        if (!response.ok) {
          throw new Error(`Leaderboard request failed with ${response.status}.`);
        }
        return response.json() as Promise<LeaderboardData>;
      })
      .then((payload) => {
        data = payload;
        payload.datasets.forEach((dataset) => {
          const option = document.createElement("option");
          option.value = `dataset:${dataset.id}`;
          option.textContent = dataset.label;
          viewSelect.append(option);
        });

        document.querySelectorAll<HTMLElement>("[data-model-count]").forEach((element) => {
          element.textContent = payload.rankings.consensus.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-total-model-count]").forEach((element) => {
          element.textContent = payload.models.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-dataset-count]").forEach((element) => {
          element.textContent = payload.datasets.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-result-count]").forEach((element) => {
          element.textContent = payload.results.length.toLocaleString();
        });


        viewSelect.disabled = false;
        search.disabled = false;
        loader.hidden = true;
        output.hidden = false;
        render();
      })
      .catch((requestError: unknown) => {
        console.error("Unable to load leaderboard data.", requestError);
        loader.hidden = true;
        error.hidden = false;
        error.textContent =
          "The leaderboard could not be loaded. Retry the request or use the CSV download above.";
        retry.hidden = false;
      })
      .finally(() => {
        window.clearTimeout(requestTimeout);
      });

    viewSelect.addEventListener("change", render);
    search.addEventListener("input", render);
    closeDetail.addEventListener("click", () => {
      detail.close();
    });
    retry.addEventListener("click", () => {
      window.location.reload();
    });
  }

  initializeLeaderboard();
</script>

<style>
  .leaderboard-intro {
    padding: 2rem 0 1rem;
  }

  .leaderboard-facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 3rem 0 1rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .leaderboard-exclusions {
    margin: -0.5rem 0 2.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .leaderboard-exclusions summary {
    width: fit-content;
    padding: 0.7rem 0;
    cursor: pointer;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 620;
  }

  .leaderboard-exclusions > div {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem;
    padding: 1rem 0 1.5rem;
  }

  .leaderboard-exclusions h2 {
    margin: 0 0 0.8rem;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .leaderboard-exclusions ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leaderboard-exclusions li {
    display: grid;
    grid-template-columns: minmax(11rem, 0.7fr) 1fr;
    gap: 0.8rem;
    padding-bottom: 0.45rem;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
    font-size: 0.72rem;
  }

  .leaderboard-exclusions code {
    color: var(--ink);
  }

  .leaderboard-facts div {
    padding: 1.25rem;
  }

  .leaderboard-facts div + div {
    border-left: 1px solid var(--line);
  }

  .leaderboard-facts dt {
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 670;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .leaderboard-facts dd {
    margin: 0.65rem 0 0;
    font-size: var(--text-lg);
    font-weight: 560;
    letter-spacing: -0.035em;
  }

  .leaderboard-app {
    position: relative;
    margin-bottom: clamp(5rem, 10vw, 9rem);
    border: 1px solid var(--line-strong);
  }

  .leaderboard-toolbar {
    display: grid;
    grid-template-columns: minmax(13rem, 0.55fr) minmax(14rem, 1fr) auto;
    align-items: end;
    gap: 0.8rem;
    padding: 1.1rem;
    background: var(--paper-soft);
    border-bottom: 1px solid var(--line-strong);
  }

  .leaderboard-toolbar label {
    display: grid;
    gap: 0.38rem;
  }

  .leaderboard-toolbar label > span {
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 680;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .leaderboard-toolbar select,
  .leaderboard-toolbar input {
    width: 100%;
    height: 2.8rem;
    padding: 0 0.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 0;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.8rem;
    padding: 0 0.8rem;
    color: var(--ink);
