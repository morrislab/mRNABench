---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { withBase } from "../lib/site";
---

<BaseLayout
  title="Leaderboard | mRNABench"
  description="Compare mRNA model results across prediction tasks and datasets."
>
  <PageIntro
    eyebrow="Benchmark results"
    title="Leaderboard"
    lead="Rank models across the included datasets using each dataset's default split. Choose an overall, prediction-task, or dataset view."
  />

  <section class="leaderboard-intro shell">
    <dl class="leaderboard-facts">
      <div><dt>Complete overall rankings</dt><dd data-model-count>--</dd></div>
      <div><dt>Models evaluated</dt><dd data-total-model-count>--</dd></div>
      <div><dt>Datasets</dt><dd data-dataset-count>--</dd></div>
      <div><dt>Model-target summaries</dt><dd data-result-count>--</dd></div>
    </dl>
    <p class="leaderboard-facts__note" data-coverage-note>Loading coverage summary.</p>
  </section>

  <section
    class="leaderboard-app shell"
    id="results"
    data-leaderboard
    data-endpoint={withBase("/data/leaderboard.json")}
  >
    <div class="leaderboard-toolbar">
      <label>
        <span>View</span>
        <select data-ranking-level disabled>
          <option value="overall">Overall</option>
          <option value="task">Prediction task</option>
          <option value="dataset">Dataset</option>
        </select>
      </label>
      <label data-task-control hidden>
        <span>Prediction task</span>
        <select data-task-view disabled>
          <option value="classification">Classification</option>
          <option value="multilabel">Multilabel</option>
          <option value="regression">Regression</option>
        </select>
      </label>
      <label data-dataset-control hidden>
        <span>Dataset</span>
        <select data-dataset-view disabled></select>
      </label>
      <label class="leaderboard-toolbar__search">
        <span>Find a model</span>
        <input type="search" data-model-search placeholder="Model or family" disabled />
      </label>
      <button class="download-link" type="button" data-download-view disabled>
        Download current-view result units
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 2V11M4.5 7.5L8 11L11.5 7.5M2 14H14"></path>
        </svg>
      </button>
    </div>

    <div
      class="leaderboard-status"
      data-loading-container
      role="status"
      aria-live="polite"
    >
      <span aria-hidden="true"></span>
      <strong>Loading leaderboard</strong>
    </div>
    <noscript>
      <style>[data-loading-container] { display: none; }</style>
      <p class="leaderboard-error">
        The interactive ranking needs JavaScript.{" "}
        <a href={withBase("/data/leaderboard-results.csv")} download>
          Download all result units
        </a>{" "}
        to inspect the results.
      </p>
    </noscript>
    <p class="leaderboard-error" data-leaderboard-error role="alert" hidden></p>
    <button class="leaderboard-retry" type="button" data-leaderboard-retry hidden>Retry loading results</button>

    <div class="leaderboard-output" data-leaderboard-output hidden>
      <div class="leaderboard-output__heading">
        <div>
          <p data-view-kicker>All submitted datasets</p>
          <h2 id="leaderboard-view-title" data-view-title>Overall ranking</h2>
        </div>
        <p data-view-description>
          Mean standardized metric across source datasets. Higher is better.
        </p>
      </div>
      <p class="leaderboard-output__context" data-view-context hidden></p>
      <div class="table-scroll" tabindex="0" role="region" aria-label="Leaderboard results table">
        <table aria-labelledby="leaderboard-view-title">
          <thead data-leaderboard-head></thead>
          <tbody data-leaderboard-body></tbody>
        </table>
      </div>
      <p class="empty-state" data-empty-state role="status" aria-live="polite" hidden>No models match that search.</p>
    </div>

    <dialog class="model-detail" data-model-detail aria-labelledby="model-detail-title">
      <button type="button" data-close-detail aria-label="Close model details">Close</button>
      <div data-model-detail-content></div>
    </dialog>
  </section>

  <section class="leaderboard-method section">
    <div class="shell">
      <div class="leaderboard-method__heading">
        <p class="eyebrow">How ranking works</p>
        <h2>From split seeds to mean z-score</h2>
      </div>
      <ol>
        <li>
          <span>01</span>
          <h3>Standardize each target</h3>
          <p>Within each seed, dataset, and target, model performance is converted to a z-score. Pearson correlations receive a Fisher transform first.</p>
        </li>
        <li>
          <span>02</span>
          <h3>Combine related results</h3>
          <p>Within each seed, z-scores are averaged across targets, then across related sub-datasets such as cell lines or species.</p>
        </li>
        <li>
          <span>03</span>
          <h3>Average split seeds</h3>
          <p>Each model is evaluated on ten train-test splits. The aggregated z-scores are then averaged across those seeds.</p>
        </li>
        <li>
          <span>04</span>
          <h3>Compute the overall score</h3>
          <p>Complete models are ranked by their mean z-score across the 11 source datasets represented by the 19 registered dataset IDs.</p>
        </li>
      </ol>
      <p class="leaderboard-method__note">
        Standardization makes AUPRC and Pearson correlation comparable only as
        relative performance within the same target. The overall score is the
        manuscript's mean standardized metric, not an absolute measure of
        biological performance. Regression uses cross-validated Ridge results.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  interface TaskRank {
    rank: number | null;
    model_id: string;
    model_family: string;
    score: number;
    coverage_ratio: number;
    dataset_count: number;
    expected_datasets: number;
    source_group_count: number;
    expected_source_groups: number;
    rank_eligible: boolean;
  }

  interface OverallRank {
    rank: number;
    model_id: string;
    model_family: string;
    mean_z_score: number;
    task_ranks: Record<string, number>;
    task_scores: Record<string, number>;
    coverage_ratio: number;
  }

  interface DatasetRank {
    rank: number | null;
    model_id: string;
    model_family: string;
    score: number;
    raw_mean: number;
    metric_id: string;
    coverage_ratio: number;
    target_count: number;
    expected_targets: number;
    rank_eligible: boolean;
  }

  interface ResultUnit {
    model_id: string;
    model_family: string;
    dataset_id: string;
    source_group: string;
    result_release_id: string;
    target_col: string;
    biological_task: string;
    result_task: string;
    evaluation_method: string;
    estimator: string;
    split_type: string;
    split_role: string;
    metric_id: string;
    higher_is_better: boolean;
    mean: number;
    std_sample: number | null;
    mean_z_score: number;
    std_z_score: number | null;
    ci95_low: number | null;
    ci95_high: number | null;
    n_runs: number;
    expected_runs: number;
    coverage_status: string;
    data_status: string;
    seeds: number[];
    source_tasks: string[];
  }

  interface DatasetInfo {
    id: string;
    label: string;
    biological_task: string;
    task_label: string;
    metric_id: string;
    target_count: number;
    source_group: string;
    split_type: string;
  }

  interface LeaderboardData {
    source: {
      label: string;
      artifact: string;
      artifact_sha256: string;
      package_commit: string | null;
    };
    row_stats: {
      retained_seed_rows: number;
      resolved_legacy_collision_rows: number;
      material_legacy_collision_keys: number;
      max_legacy_collision_difference: number;
    };
    tasks: Array<{ id: string; label: string }>;
    datasets: DatasetInfo[];
    models: Array<{ id: string; family: string }>;
    rankings: {
      overall: OverallRank[];
      classification: TaskRank[];
      multilabel: TaskRank[];
      regression: TaskRank[];
    };
    dataset_rankings: Record<string, DatasetRank[]>;
    results: ResultUnit[];
  }

  type RankingRow = OverallRank | TaskRank | DatasetRank;

  const taskLabels: Record<string, string> = {
    classification: "Classification",
    multilabel: "Multilabel",
    regression: "Regression",
  };

  const metricLabels: Record<string, string> = {
    auprc: "AUPRC",
    auprc_micro: "micro-AUPRC",
    pearson_r: "Pearson r",
  };

  const escapeHtml = (value: string) =>
    value.replace(
      /[&<>"']/g,
      (character) =>
        ({
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        })[character] ?? character,
    );

  const metric = (value: number | null) => (
    value == null ? "Not estimable" : value.toFixed(3)
  );
  const zScore = (value: number | null) => {
    if (value == null) return "Not estimable";
    return `${value >= 0 ? "+" : ""}${value.toFixed(2)}`;
  };
  const interval = (low: number | null, high: number | null) => (
    low == null || high == null
      ? "Not estimable"
      : `[${metric(low)}, ${metric(high)}]`
  );
  const rankLabel = (
    rank: number | null,
    coverageRatio: number,
  ) => {
    if (rank != null) return `#${rank}`;
    return coverageRatio < 1
      ? "Not ranked: incomplete targets"
      : "Not ranked: incomplete seed runs";
  };

  function initializeLeaderboard() {
    const app = document.querySelector<HTMLElement>("[data-leaderboard]");
    if (!app || app.dataset.initialized === "true") return;
    app.dataset.initialized = "true";

    const endpoint = app.dataset.endpoint;
    const levelSelect = app.querySelector<HTMLSelectElement>(
      "[data-ranking-level]",
    );
    const taskSelect = app.querySelector<HTMLSelectElement>("[data-task-view]");
    const datasetSelect = app.querySelector<HTMLSelectElement>(
      "[data-dataset-view]",
    );
    const taskControl = app.querySelector<HTMLElement>("[data-task-control]");
    const datasetControl = app.querySelector<HTMLElement>(
      "[data-dataset-control]",
    );
    const search = app.querySelector<HTMLInputElement>("[data-model-search]");
    const download = app.querySelector<HTMLButtonElement>(
      "[data-download-view]",
    );
    const coverageNote = document.querySelector<HTMLElement>(
      "[data-coverage-note]",
    );
    const loader = app.querySelector<HTMLElement>("[data-loading-container]");
    const output = app.querySelector<HTMLElement>("[data-leaderboard-output]");
    const error = app.querySelector<HTMLElement>("[data-leaderboard-error]");
    const retry = app.querySelector<HTMLButtonElement>("[data-leaderboard-retry]");
    const head = app.querySelector<HTMLElement>("[data-leaderboard-head]");
    const body = app.querySelector<HTMLElement>("[data-leaderboard-body]");
    const empty = app.querySelector<HTMLElement>("[data-empty-state]");
    const kicker = app.querySelector<HTMLElement>("[data-view-kicker]");
    const title = app.querySelector<HTMLElement>("[data-view-title]");
    const description = app.querySelector<HTMLElement>("[data-view-description]");
    const context = app.querySelector<HTMLElement>("[data-view-context]");
    const detail = app.querySelector<HTMLDialogElement>("[data-model-detail]");
    const detailContent = app.querySelector<HTMLElement>("[data-model-detail-content]");
    const closeDetail = app.querySelector<HTMLButtonElement>("[data-close-detail]");

    if (
      !endpoint ||
      !levelSelect ||
      !taskSelect ||
      !datasetSelect ||
      !taskControl ||
      !datasetControl ||
      !search ||
      !download ||
      !coverageNote ||
      !loader ||
      !output ||
      !error ||
      !retry ||
      !head ||
      !body ||
      !empty ||
      !kicker ||
      !title ||
      !description ||
      !context ||
      !detail ||
      !detailContent ||
      !closeDetail
    ) {
      return;
    }

    let data: LeaderboardData;
    let detailTrigger: HTMLButtonElement | null = null;

    const selectedDataset = () => {
      return data.datasets.find(
        (dataset) => dataset.id === datasetSelect.value,
      ) ?? null;
    };

    const getRows = (): RankingRow[] => {
      if (levelSelect.value === "dataset") {
        const dataset = selectedDataset();
        return dataset ? data.dataset_rankings[dataset.id] ?? [] : [];
      }
      if (levelSelect.value === "task") {
        return data.rankings[
          taskSelect.value as keyof LeaderboardData["rankings"]
        ] ?? [];
      }
      return data.rankings.overall;
    };

    const renderDetail = (modelId: string) => {
      const model = data.models.find((item) => item.id === modelId);
      const overall = data.rankings.overall.find((item) => item.model_id === modelId);
      const datasetRows = data.datasets
        .map((dataset) => {
          const row = data.dataset_rankings[dataset.id]?.find(
            (entry) => entry.model_id === modelId,
          );
          return row ? { dataset, row } : null;
        })
        .filter(
          (item): item is { dataset: DatasetInfo; row: DatasetRank } => item !== null,
        );

      const taskRankMarkup = ["classification", "multilabel", "regression"]
        .map((task) => {
          const row = data.rankings[task as keyof LeaderboardData["rankings"]]
            .find((entry) => entry.model_id === modelId) as TaskRank | undefined;
          const rank = row
            ? rankLabel(row.rank, row.coverage_ratio)
            : "No results";
          const score = row ? zScore(row.score) : "Not available";
          return `<div>
            <span>${taskLabels[task]}</span>
            <strong>${rank}</strong>
            <small>Mean z-score ${score}</small>
          </div>`;
        })
        .join("");

      const datasetMarkup = datasetRows
        .map(({ dataset, row }) => {
          const rank = rankLabel(row.rank, row.coverage_ratio);
          return `<tr>
            <td>${escapeHtml(dataset.label)}</td>
            <td>${escapeHtml(metricLabels[row.metric_id] ?? row.metric_id)}</td>
            <td>${metric(row.raw_mean)}</td>
            <td>${zScore(row.score)}</td>
            <td>${rank}</td>
          </tr>`;
        })
        .join("");
      const unitMarkup = data.results
        .filter((unit) => unit.model_id === modelId)
        .map((unit) => {
          const dataset = data.datasets.find((item) => item.id === unit.dataset_id);
          return `<tr>
            <td>${escapeHtml(dataset?.label ?? unit.dataset_id)}</td>
            <td><code>${escapeHtml(unit.target_col)}</code></td>
            <td>${escapeHtml(metricLabels[unit.metric_id] ?? unit.metric_id)}</td>
            <td>${metric(unit.mean)}</td>
            <td>${zScore(unit.mean_z_score)}</td>
            <td>${interval(unit.ci95_low, unit.ci95_high)}</td>
            <td>${escapeHtml(unit.evaluation_method)} / ${escapeHtml(unit.estimator)}</td>
            <td>${escapeHtml(unit.split_type)}</td>
            <td>${unit.n_runs}/${unit.expected_runs}</td>
          </tr>`;
        })
        .join("");

      detailContent.innerHTML = `
        <p class="model-detail__eyebrow">Model detail</p>
        <h2 id="model-detail-title">${escapeHtml(modelId)}</h2>
        <p class="model-detail__family">${escapeHtml(model?.family ?? "")}</p>
        <div class="model-detail__ranks">
          ${taskRankMarkup}
        </div>
        <p class="model-detail__summary">${
          overall
            ? `Overall #${overall.rank}, with a mean z-score of ${zScore(overall.mean_z_score)}.`
            : "Incomplete task coverage; no overall rank is assigned."
        }</p>
        <div class="model-detail__table" tabindex="0" role="region" aria-label="Dataset summary table">
          <table aria-label="Dataset summary">
            <thead><tr><th>Dataset</th><th>Metric</th><th>Mean</th><th>Mean z-score</th><th>Rank</th></tr></thead>
            <tbody>${datasetMarkup}</tbody>
          </table>
        </div>
        <h3 class="model-detail__unit-heading">Target-level result units</h3>
        <div class="model-detail__table" tabindex="0" role="region" aria-label="Target-level result table">
          <table aria-label="Target-level result units">
            <thead><tr><th>Dataset</th><th>Target</th><th>Metric</th><th>Mean</th><th>Mean z-score</th><th>95% CI</th><th>Evaluator / estimator</th><th>Split</th><th>Runs</th></tr></thead>
            <tbody>${unitMarkup}</tbody>
          </table>
        </div>
      `;
      detail.showModal();
      closeDetail.focus();
    };

    const render = () => {
      const level = levelSelect.value;
      const dataset = level === "dataset" ? selectedDataset() : null;
      const task = taskSelect.value;
      const query = search.value.trim().toLowerCase();
      const rows = getRows().filter((row) =>
        `${row.model_id} ${row.model_family}`.toLowerCase().includes(query),
      );

      taskControl.hidden = level !== "task";
      datasetControl.hidden = level !== "dataset";
      context.hidden = true;

      if (level === "dataset" && dataset) {
        kicker.textContent = dataset.task_label;
        title.textContent = dataset.label;
        description.textContent = `${metricLabels[dataset.metric_id] ?? dataset.metric_id} on the ${dataset.split_type} split, averaged over ${dataset.target_count} target${dataset.target_count === 1 ? "" : "s"}.`;
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Mean metric</th><th>Mean z-score</th>
        </tr>`;
      } else if (level === "task") {
        const taskDatasets = data.datasets
          .filter((item) => item.biological_task === task)
          .map((item) => item.label);
        kicker.textContent = "Prediction task";
        title.textContent = `${taskLabels[task]} ranking`;
        description.textContent =
          "Mean z-score across source-dataset groups in this prediction task. Higher is better.";
        context.textContent = `Registered datasets in this view: ${taskDatasets.join(", ")}.`;
        context.hidden = false;
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Mean z-score</th><th>Source groups</th>
        </tr>`;
      } else {
        kicker.textContent = "All submitted datasets";
        title.textContent = "Overall ranking";
        description.textContent =
          "Mean z-score across 11 source datasets. Higher is better.";
        head.innerHTML = `<tr>
          <th>Rank</th><th>Model</th><th>Family</th><th>Task z-scores</th><th>Mean z-score</th>
        </tr>`;
      }

      body.innerHTML = rows
        .map((row) => {
          const rankReason = (
            row.rank == null
              ? row.coverage_ratio < 1
                ? "Incomplete target coverage"
                : "Incomplete seed coverage"
              : ""
          );
          const rank = row.rank == null ? "NR" : String(row.rank);
          const rankMarkup = rankReason
            ? `<span>${rank}</span><small>${rankReason}</small>`
            : rank;
          const eligible = "rank_eligible" in row ? row.rank_eligible : true;
          let middleCells = "";

          if ("mean_z_score" in row) {
            middleCells = `<td class="task-ranks">
                <div class="task-ranks__grid">
                  <span><small>Classification</small><strong>${zScore(row.task_scores.classification)}</strong></span>
                  <span><small>Multilabel</small><strong>${zScore(row.task_scores.multilabel)}</strong></span>
                  <span><small>Regression</small><strong>${zScore(row.task_scores.regression)}</strong></span>
                </div>
              </td>
              <td class="numeric">${zScore(row.mean_z_score)}</td>`;
          } else if ("raw_mean" in row) {
            middleCells = `<td class="numeric">${metric(row.raw_mean)}</td>
              <td class="numeric">${zScore(row.score)}</td>`;
          } else {
            middleCells = `<td class="numeric">${zScore(row.score)}</td>
              <td class="numeric">${row.source_group_count}/${row.expected_source_groups}</td>`;
          }

          return `<tr data-rank="${rank}" data-eligible="${eligible}">
            <td class="rank">${rankMarkup}</td>
            <td><button class="model-button" type="button" data-model-id="${escapeHtml(row.model_id)}">${escapeHtml(row.model_id)}</button></td>
            <td class="family">${escapeHtml(row.model_family)}</td>
            ${middleCells}
          </tr>`;
        })
        .join("");

      empty.hidden = rows.length !== 0;
      body.querySelectorAll<HTMLButtonElement>("[data-model-id]").forEach((button) => {
        button.addEventListener("click", () => {
          const modelId = button.dataset.modelId;
          if (modelId) {
            detailTrigger = button;
            renderDetail(modelId);
          }
        });
      });
    };

    const csvColumns: Array<keyof ResultUnit> = [
      "model_id",
      "model_family",
      "source_group",
      "result_release_id",
      "dataset_id",
      "target_col",
      "biological_task",
      "result_task",
      "evaluation_method",
      "estimator",
      "split_type",
      "split_role",
      "metric_id",
      "higher_is_better",
      "n_runs",
      "expected_runs",
      "mean",
      "std_sample",
      "mean_z_score",
      "std_z_score",
      "ci95_low",
      "ci95_high",
      "coverage_status",
      "data_status",
      "seeds",
      "source_tasks",
    ];

    const csvValue = (value: unknown) => {
      const text = Array.isArray(value) ? value.join("|") : String(value ?? "");
      return /[",\n]/.test(text)
        ? `"${text.replaceAll('"', '""')}"`
        : text;
    };

    const downloadCurrentView = () => {
      const visibleModels = new Set(
        getRows()
          .filter((row) => (
            `${row.model_id} ${row.model_family}`
              .toLowerCase()
              .includes(search.value.trim().toLowerCase())
          ))
          .map((row) => row.model_id),
      );
      const dataset = selectedDataset();
      const rows = data.results.filter((result) => {
        if (!visibleModels.has(result.model_id)) return false;
        if (levelSelect.value === "task") {
          return result.biological_task === taskSelect.value;
        }
        if (levelSelect.value === "dataset") {
          return result.dataset_id === dataset?.id;
        }
        return true;
      });
      const csv = [
        csvColumns.join(","),
        ...rows.map((row) => (
          csvColumns.map((column) => csvValue(row[column])).join(",")
        )),
      ].join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      const scope = (
        levelSelect.value === "task"
          ? taskSelect.value
          : levelSelect.value === "dataset"
            ? dataset?.id ?? "dataset"
            : "overall"
      );
      link.href = url;
      link.download = `mrnabench-${scope}-results.csv`;
      link.click();
      URL.revokeObjectURL(url);
    };

    const requestController = new AbortController();
    const requestTimeout = window.setTimeout(
      () => requestController.abort(),
      30_000,
    );
    fetch(endpoint, { signal: requestController.signal })
      .then((response) => {
        if (!response.ok) {
          throw new Error(`Leaderboard request failed with ${response.status}.`);
        }
        return response.json() as Promise<LeaderboardData>;
      })
      .then((payload) => {
        data = payload;
        payload.tasks.forEach((task) => {
          const group = document.createElement("optgroup");
          group.label = task.label;
          payload.datasets
            .filter((dataset) => dataset.biological_task === task.id)
            .sort((left, right) => left.label.localeCompare(right.label))
            .forEach((dataset) => {
              const option = document.createElement("option");
              option.value = dataset.id;
              option.textContent = dataset.label;
              group.append(option);
            });
          datasetSelect.append(group);
        });

        document.querySelectorAll<HTMLElement>("[data-model-count]").forEach((element) => {
          element.textContent = payload.rankings.overall.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-total-model-count]").forEach((element) => {
          element.textContent = payload.models.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-dataset-count]").forEach((element) => {
          element.textContent = payload.datasets.length.toLocaleString();
        });
        document.querySelectorAll<HTMLElement>("[data-result-count]").forEach((element) => {
          element.textContent = payload.results.length.toLocaleString();
        });

        const overallModels = new Set(
          payload.rankings.overall.map((row) => row.model_id),
        );
        const partialModels = [
          ...new Set(
            payload.models
              .filter((model) => !overallModels.has(model.id))
              .map((model) => model.family),
          ),
        ].sort();
        const cdsOnlyPartial = (
          partialModels.length === 2
          && partialModels.includes("CodonBERT")
          && partialModels.includes("mRNA-FM")
        );
        coverageNote.textContent = (
          partialModels.length === 0
            ? `All ${payload.models.length} evaluated models have complete results across all ${payload.datasets.length} datasets.`
            : `${payload.rankings.overall.length} models have complete results across all ${payload.datasets.length} datasets. ${partialModels.join(" and ")} have partial results and remain available in task and dataset views.${cdsOnlyPartial ? " Both models embed only coding sequence, while the missing MRL MPRA tasks vary the 5' UTR with a fixed reporter CDS; identical model inputs make Pearson correlation undefined." : ""}`
        );


        levelSelect.disabled = false;
        taskSelect.disabled = false;
        datasetSelect.disabled = false;
        search.disabled = false;
        download.disabled = false;
        loader.hidden = true;
        output.hidden = false;
        render();
      })
      .catch((requestError: unknown) => {
        console.error("Unable to load leaderboard data.", requestError);
        loader.hidden = true;
        error.hidden = false;
        error.textContent =
          "The leaderboard could not be loaded. Retry the request or use the CSV download above.";
        retry.hidden = false;
      })
      .finally(() => {
        window.clearTimeout(requestTimeout);
      });

    levelSelect.addEventListener("change", render);
    taskSelect.addEventListener("change", render);
    datasetSelect.addEventListener("change", render);
    search.addEventListener("input", render);
    download.addEventListener("click", downloadCurrentView);
    closeDetail.addEventListener("click", () => {
      detail.close();
    });
    detail.addEventListener("click", (event) => {
      const bounds = detail.getBoundingClientRect();
      const inside = (
        event.clientX >= bounds.left
        && event.clientX <= bounds.right
        && event.clientY >= bounds.top
        && event.clientY <= bounds.bottom
      );
      if (!inside) detail.close();
    });
    detail.addEventListener("close", () => {
      detailTrigger?.focus();
      detailTrigger = null;
    });
    retry.addEventListener("click", () => {
      window.location.reload();
    });
  }

  initializeLeaderboard();
</script>

