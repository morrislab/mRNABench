---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Callout from "../../components/Callout.astro";
import CodeBlock from "../../components/CodeBlock.astro";

const datasetsInstall = `git clone --branch t_dev https://github.com/morrislab/mRNABench.git
cd mRNABench

conda create --name mrna_bench python=3.12
conda activate mrna_bench
python -m pip install -e .`;

const paths = `import mrna_bench as mb

mb.update_data_path("/absolute/path/to/mrnabench-data")
mb.update_model_weights_path("/absolute/path/to/model-weights")`;

const sourceInstall = `python -m pip install \\
  --index-url https://download.pytorch.org/whl/cu126 \\
  torch==2.7.1

python -m pip install wheel packaging ninja
python -m pip install --no-build-isolation -e '.[base_models]'`;

const loadDataset = `import mrna_bench as mb

dataset = mb.load_dataset("go-mf")

print(dataset.data_df.head())
print(dataset.metadata)`;

const firstBenchmark = `import torch
import mrna_bench as mb

from mrna_bench.embedder import DatasetEmbedder
from mrna_bench.linear_probe import LinearProbeBuilder

device = torch.device("cuda")

dataset = mb.load_dataset("go-mf")
model = mb.load_model(
    "Orthrus",
    "orthrus-large-6-track",
    device=device,
)

embeddings = DatasetEmbedder(
    model,
    dataset,
    batch_size=8,
).embed_dataset()
embeddings = torch.stack(embeddings).cpu().numpy()

probe = (
    LinearProbeBuilder(dataset)
    .fetch_embedding_by_embedding_instance(
        model.short_name,
        embeddings,
    )
    .build()
)

metrics = probe.run_linear_probe(random_seed=2541)
print(metrics)`;
---

<DocsLayout
  title="Quickstart"
  description="Install the package, choose its storage paths, load a dataset, and run one linear probe."
  section="Start"
>
  <h2>Choose the installation you need</h2>
  <p>
    The commands below install the unreleased v2.0.0 source API. Do not
    substitute the current PyPI package if you need the catalog and result
    schema documented here.
  </p>

  <h3>Datasets and evaluation from source</h3>
  <CodeBlock code={datasetsInstall} language="shell" />

  <h3>Model inference</h3>
  <CodeBlock code={sourceInstall} language="shell" />

  <Callout tone="important" label="CUDA requirement">
    <p>
      The model extra builds <code>flash-attn</code> and
      <code>mamba-ssm</code> CUDA extensions from source. Use a CUDA 12.6
      development environment with matching headers and <code>nvcc</code>.
      The model catalog lists inference behavior, not complete CPU, VRAM, or
      hardware compatibility.
    </p>
  </Callout>

  <h2>Set persistent storage</h2>
  <p>
    mRNABench downloads processed data and model weights outside the package.
    Set these paths once before loading a dataset or model. If the model path is
    omitted, it defaults to a <code>model_weights</code> directory below the
    data path.
  </p>
  <CodeBlock code={paths} language="python" />

  <h2>Load a dataset</h2>
  <CodeBlock code={loadDataset} language="python" />
  <p>
    The returned <code>BenchmarkDataset</code> contains the processed dataframe
    and the metadata used to choose its task, target, default split, and
    supported evaluation routes.
  </p>

  <h2>Run one benchmark in memory</h2>
  <CodeBlock code={firstBenchmark} language="python" />
  <p>
    <code>LinearProbeBuilder</code> reads defaults from dataset metadata. In
    this example that includes the first declared task and target, the dataset's
    default split, and the matching evaluator. The benchmarking guide shows how
    to override each choice and how to persist larger runs.
  </p>

  <Callout>
    <p>
      Repository scripts are not installed as shell commands. Run them from a
      source checkout with <code>python scripts/...</code>.
    </p>
  </Callout>
</DocsLayout>
