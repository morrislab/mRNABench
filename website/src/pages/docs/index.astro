---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { withBase } from "../../lib/site";

const install = `python -m pip install mrna-bench`;

const routes = [
  {
    number: "01",
    title: "Evaluate a model",
    text: "Load a model and dataset, generate embeddings, and run an evaluation.",
    href: "/docs/quickstart",
  },
  {
    number: "02",
    title: "Add a dataset",
    text: "Define the dataframe columns and metadata, then register the dataset.",
    href: "/docs/add-dataset",
  },
  {
    number: "03",
    title: "Add a model",
    text: "Implement an EmbeddingModel adapter for one or more checkpoints.",
    href: "/docs/add-model",
  },
];
---

<DocsLayout
  title="Documentation"
  description="Install mRNABench, run evaluations, inspect results, or add a dataset or model."
  section="Documentation"
>
  <p>
    Start with a complete run, or go directly to the dataset, model, result,
    and API reference pages.
  </p>

  <CodeBlock code={install} language="shell" label="Install from PyPI" />

  <h2>Choose a workflow</h2>
  <div class="doc-routes">
    {
      routes.map((route) => (
        <a href={withBase(route.href)}>
          <span>{route.number}</span>
          <strong>{route.title}</strong>
          <p>{route.text}</p>
          <i aria-hidden="true">→</i>
        </a>
      ))
    }
  </div>

  <h2>Guide sections</h2>
  <p>
    Use the quickstart for an end-to-end example and the concepts guide for
    evaluation defaults. The Python API page lists current signatures and
    parameter names directly from the package source.
  </p>

  <table tabindex="0" aria-label="Documentation sections">
    <thead>
      <tr>
        <th>Section</th>
        <th>Use it for</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Start</td>
        <td>Installation, first run, and the package vocabulary.</td>
      </tr>
      <tr>
        <td>Run</td>
        <td>Configuration, benchmark execution, result files, and analysis.</td>
      </tr>
      <tr>
        <td>Extend</td>
        <td>New datasets and model adapters.</td>
      </tr>
      <tr>
        <td>Reference</td>
        <td>Current Python signatures and parameter notes.</td>
      </tr>
    </tbody>
  </table>
</DocsLayout>

<style>
  .doc-routes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1.8rem 0 2rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .doc-routes a {
    position: relative;
    min-height: 18rem;
    padding: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .doc-routes a + a {
    border-left: 1px solid var(--line-strong);
  }

  .doc-routes a:hover {
    background: var(--paper-soft);
  }

  .doc-routes span {
    display: block;
    margin-bottom: 3.5rem;
    color: var(--red-deep);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .doc-routes strong {
    display: block;
    font-size: 1.08rem;
    font-weight: 620;
  }

  .doc-routes p {
    margin-top: 0.65rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .doc-routes i {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    color: var(--red);
    font-style: normal;
  }

  @media (max-width: 680px) {
    .doc-routes {
      grid-template-columns: 1fr;
    }

    .doc-routes a {
      min-height: 0;
      padding-bottom: 3.5rem;
    }

    .doc-routes a + a {
      border-top: 1px solid var(--line-strong);
      border-left: 0;
    }

    .doc-routes span {
      margin-bottom: 1.5rem;
    }
  }
</style>
