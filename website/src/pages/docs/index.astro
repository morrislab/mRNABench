---
import DocsLayout from "../../layouts/DocsLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { withBase } from "../../lib/site";

const install = `python -m pip install mrna-bench`;

const routes = [
  {
    number: "01",
    title: "Evaluate a model",
    text: "Load a registered model and dataset through Python, or use the repository scripts for persisted runs.",
    href: "/docs/quickstart",
  },
  {
    number: "02",
    title: "Add a dataset",
    text: "Define dataset metadata and the shared dataframe schema, then register the dataset.",
    href: "/docs/add-dataset",
  },
  {
    number: "03",
    title: "Add a model",
    text: "Implement an EmbeddingModel adapter and declare its supported behaviors and versions.",
    href: "/docs/add-model",
  },
];
---

<DocsLayout
  title="Use mRNABench"
  description="Practical guides for running, extending, and reading the benchmark."
  section="Documentation"
>
  <p>
    The package separates datasets, model adapters, evaluators, and analyses.
    Registered datasets and model adapters can be extended independently.
  </p>

  <CodeBlock code={install} language="shell" label="Install from PyPI" />

  <h2>Choose a workflow</h2>
  <div class="doc-routes">
    {
      routes.map((route) => (
        <a href={withBase(route.href)}>
          <span>{route.number}</span>
          <strong>{route.title}</strong>
          <p>{route.text}</p>
          <i aria-hidden="true">→</i>
        </a>
      ))
    }
  </div>

  <h2>Guide sections</h2>
  <p>
    Use the quickstart for an end-to-end example and the concepts guide for
    evaluation defaults. The extension guides document the package's
    registration APIs and validation checks.
  </p>

  <table tabindex="0" aria-label="Documentation sections">
    <thead>
      <tr>
        <th>Section</th>
        <th>Use it for</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Start</td>
        <td>Installation, first run, and the package vocabulary.</td>
      </tr>
      <tr>
        <td>Run</td>
        <td>Configuration, benchmark execution, result files, and analysis.</td>
      </tr>
      <tr>
        <td>Extend</td>
        <td>New datasets, model adapters, and a map of the public API.</td>
      </tr>
    </tbody>
  </table>
</DocsLayout>

<style>
  .doc-routes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 1.8rem 0 2rem;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .doc-routes a {
    position: relative;
    min-height: 18rem;
    padding: 1.25rem;
    color: var(--ink);
    text-decoration: none;
  }

  .doc-routes a + a {
    border-left: 1px solid var(--line-strong);
  }

  .doc-routes a:hover {
    background: var(--paper-soft);
  }

  .doc-routes span {
    display: block;
    margin-bottom: 3.5rem;
    color: var(--red-deep);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .doc-routes strong {
    display: block;
    font-size: 1.08rem;
    font-weight: 620;
  }

  .doc-routes p {
    margin-top: 0.65rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .doc-routes i {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    color: var(--red);
    font-style: normal;
  }

  @media (max-width: 680px) {
    .doc-routes {
      grid-template-columns: 1fr;
    }

    .doc-routes a {
      min-height: 13rem;
    }

    .doc-routes a + a {
      border-top: 1px solid var(--line-strong);
      border-left: 0;
    }
  }
</style>
