---
import DocsLayout from "../../layouts/DocsLayout.astro";
import apiReference from "../../data/generated/api-reference.json";

const slugify = (value: string) =>
  value.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");

const entryCount = apiReference.groups.reduce(
  (count, group) => count + group.entries.length,
  0,
);
---

<DocsLayout
  title="Python API"
  description="Signatures and parameter notes for the public objects used in the guides."
  section="Reference"
>
  <p>
    This reference is generated from the package source during the website
    build. The workflow guides show how these objects fit together; use this
    page when you need an exact signature or argument name.
  </p>

  <nav class="api-sections" aria-label="API sections">
    {
      apiReference.groups.map((group) => (
        <a
          href={`#${slugify(group.title)}`}
          data-api-section-link={slugify(group.title)}
        >{group.title}</a>
      ))
    }
  </nav>

  <div class="api-filter">
    <label>
      <span>Find a class, method, or argument</span>
      <input
        type="search"
        placeholder="For example: build_splitter"
        data-api-search
      />
    </label>
    <p role="status" aria-live="polite">
      <strong data-api-count>{entryCount}</strong> entries
    </p>
  </div>

  <div class="api-reference" data-api-reference>
    {
      apiReference.groups.map((group) => (
        <section
          class="api-group"
          id={slugify(group.title)}
          data-api-group
        >
          <header>
            <h2>{group.title}</h2>
            <p>{group.description}</p>
          </header>
          <div>
            {
              group.entries.map((entry) => (
                <details
                  class="api-entry"
                  data-api-entry
                  data-api-search-text={`${entry.name} ${entry.module} ${entry.signature} ${entry.summary} ${entry.parameters.map((parameter) => `${parameter.name} ${parameter.description}`).join(" ")}`.toLowerCase()}
                >
                  <summary>
                    <span>
                      <code>{entry.module}</code>
                      <strong>{entry.name}</strong>
                    </span>
                    <span class="api-entry__summary">{entry.summary}</span>
                  </summary>
                  <div class="api-entry__body">
                    <pre tabindex="0"><code>{entry.signature}</code></pre>
                    {
                      entry.parameters.length > 0 && (
                        <>
                          <h3>Parameters</h3>
                          <dl>
                            {entry.parameters.map((parameter) => (
                              <div>
                                <dt><code>{parameter.name}</code></dt>
                                <dd>{parameter.description}</dd>
                              </div>
                            ))}
                          </dl>
                        </>
                      )
                    }
                    {
                      entry.returns && (
                        <>
                          <h3>Returns</h3>
                          <p>{entry.returns}</p>
                        </>
                      )
                    }
                    <p class="api-entry__source">
                      Source: <code>{entry.sourcePath}</code>
                    </p>
                  </div>
                </details>
              ))
            }
          </div>
        </section>
      ))
    }
    <p class="api-empty" data-api-empty hidden>
      No API entries match that search.
    </p>
  </div>
</DocsLayout>

<script>
  function initializeApiReference() {
    const reference = document.querySelector<HTMLElement>(
      "[data-api-reference]",
    );
    const search = document.querySelector<HTMLInputElement>("[data-api-search]");
    const count = document.querySelector<HTMLElement>("[data-api-count]");
    const empty = reference?.querySelector<HTMLElement>("[data-api-empty]");
    if (!reference || !search || !count || !empty) return;

    const entries = Array.from(
      reference.querySelectorAll<HTMLElement>("[data-api-entry]"),
    );
    const groups = Array.from(
      reference.querySelectorAll<HTMLElement>("[data-api-group]"),
    );
    const sectionLinks = Array.from(
      document.querySelectorAll<HTMLElement>("[data-api-section-link]"),
    );

    const filter = () => {
      const query = search.value.trim().toLowerCase();
      let visibleCount = 0;
      entries.forEach((entry) => {
        const matches = !query || entry.dataset.apiSearchText?.includes(query);
        entry.hidden = !matches;
        if (matches) visibleCount += 1;
      });
      groups.forEach((group) => {
        group.hidden = !group.querySelector("[data-api-entry]:not([hidden])");
        const link = sectionLinks.find(
          (item) => item.dataset.apiSectionLink === group.id,
        );
        if (link) link.hidden = group.hidden;
      });
      count.textContent = String(visibleCount);
      empty.hidden = visibleCount !== 0;
    };

    search.addEventListener("input", filter);
  }

  initializeApiReference();
</script>

<style>
  .api-sections {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin: 2rem 0;
    padding: 1rem 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .api-sections a {
    color: var(--ink);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .api-sections a:hover {
    color: var(--red-deep);
  }

  .api-filter {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: end;
    margin: 2rem 0 3.5rem;
    padding: 1rem;
    background: var(--paper-soft);
    border: 1px solid var(--line-strong);
  }

  .api-filter label {
    display: grid;
    gap: 0.4rem;
  }

  .api-filter label span {
    color: var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .api-filter input {
    width: 100%;
    min-height: 2.8rem;
    padding: 0.6rem 0.75rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
  }

  .api-filter p {
    margin: 0 0 0.65rem;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .api-group {
    scroll-margin-top: 6rem;
    margin: 0 0 4.5rem;
  }

  .api-group > header {
    display: grid;
    grid-template-columns: minmax(12rem, 0.45fr) 1fr;
    gap: 2rem;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .api-group > header h2 {
    margin: 0;
    padding: 0;
  }

  .api-group > header p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .api-entry {
    border-top: 1px solid var(--line-strong);
  }

  .api-entry:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .api-entry summary {
    position: relative;
    display: grid;
    grid-template-columns: minmax(14rem, 0.75fr) 1fr;
    gap: 1.5rem;
    padding: 1rem 2rem 1rem 0;
    cursor: pointer;
    list-style-position: outside;
  }

  .api-entry summary::after {
    position: absolute;
    top: 1rem;
    right: 0.25rem;
    color: var(--red-deep);
    content: "+";
    font-weight: 650;
  }

  .api-entry[open] summary::after {
    content: "-";
  }

  .api-entry summary > span {
    display: grid;
    gap: 0.35rem;
  }

  .api-entry summary code {
    width: fit-content;
    color: var(--ink-muted);
    background: transparent;
    border: 0;
    font-size: 0.7rem;
  }

  .api-entry summary strong {
    overflow-wrap: anywhere;
    font-size: var(--text-sm);
    font-weight: 650;
  }

  .api-entry__summary {
    color: var(--ink-soft);
    font-size: var(--text-sm);
  }

  .api-entry__body {
    padding: 0 0 1.8rem;
  }

  .api-entry__body pre {
    max-width: 100%;
    margin: 0 0 1.5rem;
    padding: 1rem;
    overflow-x: auto;
    color: #f6f5f1;
    background: #111113;
    border: 1px solid var(--line-strong);
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .api-entry__body h3 {
    margin: 1.5rem 0 0.5rem;
    font-size: var(--text-sm);
  }

  .api-entry__body dl {
    margin: 0;
    border-top: 1px solid var(--line);
  }

  .api-entry__body dl div {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }

  .api-entry__body dt,
  .api-entry__body dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  .api-entry__source {
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .api-empty {
    padding: 2rem 0;
    color: var(--ink-muted);
  }

  @media (max-width: 700px) {
    .api-filter,
    .api-group > header,
    .api-entry summary,
    .api-entry__body dl div {
      grid-template-columns: 1fr;
    }

    .api-filter p {
      margin: 0;
    }
  }
</style>
