---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageIntro from "../components/PageIntro.astro";
import { datasets } from "../data/datasets";

const categories = [...new Set(datasets.map((dataset) => dataset.category))];
const coreCount = datasets.filter((dataset) => dataset.benchmarkSet === "core").length;
const extendedCount = datasets.length - coreCount;
const splitLabel = {
  default: "Random",
  homology: "Homology",
  chromosome: "Chromosome",
};
const taskLabel = {
  classification: "Classification",
  multilabel: "Multilabel",
  regression: "Regression",
};
const sourceLabel = {
  human: "Human",
  mouse: "Mouse",
  mixed: "Multiple species",
  synthetic: "Synthetic constructs",
};
const setLabel = {
  core: "Core",
  extended: "Extended",
};
---

<BaseLayout
  title="Dataset catalog | mRNABench"
  description="Browse mRNABench datasets, including task, sequence source, default split, evaluation methods, and citation."
>
  <PageIntro
    eyebrow="Catalog"
    title="Datasets"
    lead="Browse each dataset's task, sequence source, default split, targets, evaluation methods, and citation."
  />

  <section class="catalog-summary shell">
    <dl>
      <div><dt>Datasets</dt><dd>{datasets.length}</dd></div>
      <div><dt>Core datasets</dt><dd>{coreCount}</dd></div>
      <div><dt>Extended datasets</dt><dd>{extendedCount}</dd></div>
      <div><dt>Research areas</dt><dd>{categories.length}</dd></div>
    </dl>
    <p>
      One study may contribute several datasets when the species, cell type,
      reporter, or sequence region changes the prediction problem.
    </p>
  </section>

  <section class="dataset-catalog shell" data-dataset-catalog>
    <div class="dataset-filters">
      <label>
        <span>Find a dataset</span>
        <input type="search" placeholder="Name or dataset ID" data-dataset-search />
      </label>
      <label>
        <span>Biological area</span>
        <select data-category-filter>
          <option value="">All areas</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label>
        <span>Task</span>
        <select data-task-filter>
          <option value="">All tasks</option>
          <option value="classification">Classification</option>
          <option value="multilabel">Multilabel</option>
          <option value="regression">Regression</option>
        </select>
      </label>
      <p role="status" aria-live="polite" data-dataset-status>{datasets.length} datasets shown</p>
    </div>

    <div class="dataset-list">
      {
        datasets.map((dataset) => (
          <article
            data-dataset-row
            data-search={`${dataset.name} ${dataset.id} ${dataset.description}`.toLowerCase()}
            data-category={dataset.category}
            data-task={dataset.task}
          >
            <div class="dataset-list__identity">
              <span>{dataset.category}</span>
              <h2>{dataset.name}</h2>
              <code>{dataset.id}</code>
            </div>
            <div class="dataset-list__description">
              <p>{dataset.description}</p>
              {dataset.accessNote && <p><strong>Access:</strong> {dataset.accessNote}</p>}
              {dataset.evaluationNote && <p><strong>Evaluation:</strong> {dataset.evaluationNote}</p>}
            </div>
            <dl>
              <div><dt>Task</dt><dd>{taskLabel[dataset.task]}</dd></div>
              <div><dt>Source</dt><dd>{sourceLabel[dataset.species]}</dd></div>
              <div><dt>Split</dt><dd>{splitLabel[dataset.split]}</dd></div>
              <div><dt>Group</dt><dd>{setLabel[dataset.benchmarkSet]}</dd></div>
              <div><dt>Targets</dt><dd>{dataset.targetSummary}</dd></div>
              <div><dt>Evaluations</dt><dd>{dataset.evaluations.join(", ")}</dd></div>
            </dl>
            <div class="dataset-list__links">
              <a href={dataset.citationUrl} aria-label={`${dataset.name}: ${dataset.citationLabel}`}>{dataset.citationLabel}</a>
              {dataset.dataUrl && <a href={dataset.dataUrl} aria-label={`${dataset.name} source data`}>Source data</a>}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  function initializeDatasetCatalog() {
    const catalog = document.querySelector<HTMLElement>("[data-dataset-catalog]");
    if (!catalog) return;
    const search = catalog.querySelector<HTMLInputElement>("[data-dataset-search]");
    const category = catalog.querySelector<HTMLSelectElement>("[data-category-filter]");
    const task = catalog.querySelector<HTMLSelectElement>("[data-task-filter]");
    const rows = [...catalog.querySelectorAll<HTMLElement>("[data-dataset-row]")];
    const status = catalog.querySelector<HTMLElement>("[data-dataset-status]");
    if (!search || !category || !task || !status) return;

    const filter = () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      rows.forEach((row) => {
        const matches =
          (!query || row.dataset.search?.includes(query)) &&
          (!category.value || row.dataset.category === category.value) &&
          (!task.value || row.dataset.task === task.value);
        row.hidden = !matches;
        if (matches) visible += 1;
      });
      status.textContent = (
        visible === 0
          ? "No datasets match those filters."
          : `${visible} ${visible === 1 ? "dataset" : "datasets"} shown`
      );
    };

    search.addEventListener("input", filter);
    category.addEventListener("change", filter);
    task.addEventListener("change", filter);
  }

  initializeDatasetCatalog();
</script>

<style>
  .catalog-summary {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: 2rem 4rem;
  }

  .catalog-summary :global(.callout) {
    grid-column: 1 / -1;
  }

  .catalog-summary dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .catalog-summary dl div {
    padding: 1rem;
  }

  .catalog-summary dl div + div {
    border-left: 1px solid var(--line);
  }

  .catalog-summary dt {
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .catalog-summary dd {
    margin: 0.5rem 0 0;
    font-size: var(--text-lg);
    font-weight: 580;
  }

  .catalog-summary > p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .dataset-catalog {
    margin-bottom: clamp(6rem, 12vw, 11rem);
  }

  .dataset-filters {
    position: sticky;
    z-index: 5;
    top: 4.5rem;
    display: grid;
    grid-template-columns: 1.3fr repeat(2, 0.7fr) auto;
    gap: 0.75rem;
    align-items: end;
    padding: 1rem;
    background: var(--paper-soft);
    border: 1px solid var(--line-strong);
  }

  .dataset-filters label {
    display: grid;
    gap: 0.35rem;
  }

  .dataset-filters label > span {
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dataset-filters input,
  .dataset-filters select {
    height: 2.7rem;
    padding: 0 0.65rem;
    background: var(--paper-raised);
    border: 1px solid var(--line-strong);
    border-radius: 0;
  }

  .dataset-filters > p {
    margin: 0 0 0.65rem;
    color: var(--ink-muted);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .dataset-list {
    border-bottom: 1px solid var(--line-strong);
  }

  .dataset-list article {
    display: grid;
    grid-template-columns:
      minmax(13rem, 0.8fr)
      minmax(14rem, 0.9fr)
      minmax(24rem, 1.45fr)
      minmax(7rem, 0.45fr);
    gap: 1.4rem;
    align-items: start;
    padding: 1.5rem 1rem;
    border-bottom: 1px solid var(--line);
  }

  .dataset-list article:hover {
    background: var(--paper-soft);
  }

  .dataset-list__identity > span {
    color: var(--red-deep);
    font-size: 0.75rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dataset-list h2 {
    margin: 0.42rem 0 0.5rem;
    font-size: var(--text-base);
    font-weight: 620;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .dataset-list code {
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  .dataset-list__description p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .dataset-list__description p + p {
    margin-top: 0.7rem;
    padding-top: 0.7rem;
    border-top: 1px solid var(--line);
  }

  .dataset-list__description strong {
    color: var(--ink);
  }

  .dataset-list dl {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem 0.85rem;
    margin: 0;
  }

  .dataset-list dl div:nth-child(n + 5) {
    grid-column: 1 / -1;
  }

  .dataset-list dt {
    color: var(--ink-muted);
    font-size: 0.72rem;
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dataset-list dd {
    margin: 0.18rem 0 0;
    font-size: 0.78rem;
  }

  .dataset-list__links {
    display: grid;
    gap: 0.4rem;
  }

  .dataset-list__links a {
    width: fit-content;
    font-size: 0.75rem;
    font-weight: 620;
  }

  @media (max-width: 1100px) {
    .catalog-summary,
    .dataset-list article {
      grid-template-columns: 1fr;
    }

    .dataset-list dl {
      grid-template-columns: repeat(3, 1fr);
    }

    .dataset-list dl div:nth-child(n + 5) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 760px) {
    .catalog-summary dl,
    .dataset-filters {
      grid-template-columns: repeat(2, 1fr);
    }

    .catalog-summary dl div:nth-child(3) {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .catalog-summary dl div:nth-child(4) {
      border-top: 1px solid var(--line);
    }

    .dataset-list dl {
      grid-template-columns: repeat(2, 1fr);
    }

    .dataset-list dl div:nth-child(n + 5) {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 520px) {
    .catalog-summary dl,
    .dataset-filters {
      grid-template-columns: 1fr;
    }

    .catalog-summary dl div + div,
    .catalog-summary dl div:nth-child(4) {
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .dataset-filters {
      position: static;
    }
  }
</style>
