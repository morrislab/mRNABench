---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import PageIntro from "../components/PageIntro.astro";
import { site, withBase } from "../lib/site";

const bibtex = `@article{shi_dalal_fradkin_2025_mrnabench,
    author = {Shi, Ruian and Dalal, Taykhoom and Fradkin, Philip and Koyyalagunta, Divya and Chhabria, Simran and Jung, Andrew and Tam, Cyrus and Ceyhan, Defne and Lin, Jessica and Laverty, Kaitlin U. and Baali, Ilyes and Wang, Bo and Morris, Quaid},
    title = {mRNABench: A curated benchmark for mature mRNA property and function prediction},
    elocation-id = {2025.07.05.662870},
    year = {2025},
    doi = {10.1101/2025.07.05.662870},
    publisher = {Cold Spring Harbor Laboratory},
    URL = {https://www.biorxiv.org/content/early/2025/07/08/2025.07.05.662870},
    eprint = {https://www.biorxiv.org/content/early/2025/07/08/2025.07.05.662870.full.pdf},
    journal = {bioRxiv}
}`;

const gaps = [
  {
    title: "Biological target",
    text: "Every task measures a property or function of mature mRNA, including translation, stability, localization, and molecular interactions.",
  },
  {
    title: "Sequence context",
    text: "Inputs range from short regulatory regions to complete transcripts containing UTRs, coding sequence, and splice context.",
  },
  {
    title: "Task breadth",
    text: "The same frozen model is evaluated across multiple assays and biological outcomes.",
  },
  {
    title: "Split strategy",
    text: "Each dataset records a split suited to its rows, including random, k-mer, chromosome, and homology grouping.",
  },
];

const findings = [
  {
    title: "Model size",
    text: "Across the models tested, parameter count was only weakly related to mean standardized performance. This comparison cannot separate model size from differences in training data, objective, architecture, or model family.",
  },
  {
    title: "Pretraining objective",
    text: "For one backbone trained on one dataset, the combined masked-token and contrastive objective performed well on more validation tasks than either objective alone. Most of the difference came from transcript-level tasks.",
  },
  {
    title: "Full-length mRNA training",
    text: "Models trained on full mature mRNAs scored higher on average than genome-only models in this set. The groups also differ in architecture, objective, and training corpus, so this is an association rather than a controlled comparison.",
  },
  {
    title: "Split strategy",
    text: "On applicable non-synthetic datasets, k-mer splits gave lower scores than random splits. The grouping uses raw k-mer counts, so sequence length also affects the split. Homology splits changed scores less consistently.",
  },
];

const paperAuthors = [
  {
    name: "Ruian (Ian) Shi",
    affiliations: [1, 2, 3],
    equalContribution: true,
  },
  {
    name: "Taykhoom Dalal",
    affiliations: [3],
    equalContribution: true,
  },
  {
    name: "Philip Fradkin",
    affiliations: [1, 2],
    equalContribution: true,
  },
  { name: "Divya Koyyalagunta", affiliations: [3] },
  { name: "Simran Chhabria", affiliations: [3] },
  { name: "Andrew Jung", affiliations: [4] },
  {
    name: "Cyrus Tam",
    affiliations: [3],
    url: "https://orcid.org/0009-0006-5545-5557",
  },
  { name: "Defne Ceyhan", affiliations: [3] },
  { name: "Jessica Lin", affiliations: [3] },
  {
    name: "Kaitlin U. Laverty",
    affiliations: [2, 3],
    url: "https://orcid.org/0009-0004-4341-4665",
  },
  { name: "Ilyes Baali", affiliations: [3] },
  {
    name: "Bo Wang",
    affiliations: [1, 2, 5],
    url: "https://orcid.org/0000-0002-9620-3413",
  },
  {
    name: "Quaid Morris",
    affiliations: [3],
    url: "https://orcid.org/0000-0002-2760-6999",
  },
];

const paperAffiliations = [
  "Department of Computer Science, University of Toronto",
  "Vector Institute",
  "Computational and Systems Biology Program, Sloan Kettering Institute",
  "Department of Electrical and Computer Engineering, University of Toronto",
  "Peter Munk Cardiac Center, University Health Network",
