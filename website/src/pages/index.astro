---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import PageIntro from "../components/PageIntro.astro";
import { site, withBase } from "../lib/site";

const bibtex = `@article{shi_dalal_fradkin_2025_mrnabench,
    author = {Shi, Ruian and Dalal, Taykhoom and Fradkin, Philip and Koyyalagunta, Divya and Chhabria, Simran and Jung, Andrew and Tam, Cyrus and Ceyhan, Defne and Lin, Jessica and Laverty, Kaitlin U. and Baali, Ilyes and Wang, Bo and Morris, Quaid},
    title = {mRNABench: A curated benchmark for mature mRNA property and function prediction},
    elocation-id = {2025.07.05.662870},
    year = {2025},
    doi = {10.1101/2025.07.05.662870},
    publisher = {Cold Spring Harbor Laboratory},
    URL = {https://www.biorxiv.org/content/early/2025/07/08/2025.07.05.662870},
    eprint = {https://www.biorxiv.org/content/early/2025/07/08/2025.07.05.662870.full.pdf},
    journal = {bioRxiv}
}`;

const gaps = [
  {
    title: "Biological focus",
    text: "DNA and non-coding RNA benchmarks do not directly test the mature-mRNA-centered tasks collected here.",
  },
  {
    title: "Sequence scale",
    text: "Short-window benchmarks cannot test integration across UTRs, coding sequence, junction context, and a complete transcript.",
  },
  {
    title: "Task breadth",
    text: "One translation or localization assay cannot establish that a representation transfers across mRNA biology.",
  },
  {
    title: "Split leakage",
    text: "Random splits can place homologous or compositionally similar transcripts on both sides of an evaluation.",
  },
];

const findings = [
  {
    title: "Model size and aggregate performance",
    text: "In the evaluated result snapshot, parameter count has only a weak association with mean standardized performance. Corpus, objective, architecture, and model family co-vary, so their individual effects cannot be isolated.",
  },
  {
    title: "Controlled objective ablation",
    text: "Within one backbone and pretraining dataset, combining masked-token and contrastive losses gave broader validation-task coverage than either loss alone. The largest gains were concentrated in transcript-level tasks.",
  },
  {
    title: "Full-length mRNA exposure",
    text: "In this model cohort, groups with explicit full-length mature-mRNA exposure had higher aggregate performance than the genome-only group. Model family, architecture, objective, and training corpus remain confounded.",
  },
  {
    title: "Effect of stricter splits",
    text: "On applicable non-synthetic datasets, raw k-mer-count splits reduced aggregate performance relative to random splits. These groups also reflect sequence length, so the result is not a motif-only leakage test. Homology splits produced smaller systematic gaps.",
  },
];

const paperAuthors = [
  {
    name: "Ruian (Ian) Shi",
    affiliations: [1, 2, 3],
    equalContribution: true,
  },
  {
    name: "Taykhoom Dalal",
    affiliations: [3],
    equalContribution: true,
  },
  {
    name: "Philip Fradkin",
    affiliations: [1, 2],
    equalContribution: true,
  },
  { name: "Divya Koyyalagunta", affiliations: [3] },
  { name: "Simran Chhabria", affiliations: [3] },
  { name: "Andrew Jung", affiliations: [4] },
  {
    name: "Cyrus Tam",
    affiliations: [3],
    url: "https://orcid.org/0009-0006-5545-5557",
  },
  { name: "Defne Ceyhan", affiliations: [3] },
  { name: "Jessica Lin", affiliations: [3] },
  {
    name: "Kaitlin U. Laverty",
    affiliations: [2, 3],
    url: "https://orcid.org/0009-0004-4341-4665",
  },
  { name: "Ilyes Baali", affiliations: [3] },
  {
    name: "Bo Wang",
    affiliations: [1, 2, 5],
    url: "https://orcid.org/0000-0002-9620-3413",
  },
  {
    name: "Quaid Morris",
    affiliations: [3],
    url: "https://orcid.org/0000-0002-2760-6999",
  },
];

const paperAffiliations = [
  "Department of Computer Science, University of Toronto",
  "Vector Institute",
  "Computational and Systems Biology Program, Sloan Kettering Institute",
  "Department of Electrical and Computer Engineering, University of Toronto",
  "Peter Munk Cardiac Center, University Health Network",
];
---

<BaseLayout
  title="mRNABench | A benchmark for mRNA representation learning"
  description="Why mRNA needs its own benchmark, how mRNABench evaluates frozen representations, and what the benchmark can and cannot show."
>
  <PageIntro
    eyebrow="Benchmark overview"
    title="A benchmark centered on mature-mRNA biology"
    lead="mRNABench evaluates linearly accessible information in frozen nucleotide-model representations across translation, stability, localization, molecular interactions, transcript lifecycle, and UTR SNV classification."
  />

  <section class="publication shell" aria-labelledby="publication-title">
    <div class="publication__label">
      <span>Public preprint</span>
      <a href={site.paper}>bioRxiv v1</a>
    </div>
    <div class="publication__content">
      <h2 id="publication-title">
        mRNABench: A curated benchmark for mature mRNA property and function
        prediction
      </h2>
      <p class="publication__authors">
        {
          paperAuthors.map((author, index) => (
            <>
              {author.url ? (
                <a href={author.url}>{author.name}</a>
              ) : (
                <span>{author.name}</span>
              )}
              <sup>
                {author.equalContribution && "†"}
                {author.affiliations.join(",")}
              </sup>
              {index < paperAuthors.length - 1 && ", "}
            </>
          ))
        }
      </p>
      <ol class="publication__affiliations">
        {
          paperAffiliations.map((affiliation, index) => (
            <li><span>{index + 1}</span>{affiliation}</li>
          ))
        }
      </ol>
      <p class="publication__note">
        <span>† Equal contribution</span>
        <a href={site.paper}>doi:10.1101/2025.07.05.662870</a>
      </p>
    </div>
  </section>

  <nav class="overview-nav shell" aria-label="On this page">
    <span>On this page</span>
    <a href="#need">Why mRNA</a>
    <a href="#design">Design</a>
    <a href="#splits">Splits</a>
    <a href="#findings">Findings</a>
    <a href="#limits">Limits</a>
    <a href="#citation">Citation</a>
  </nav>

  <section class="section" id="need">
    <div class="shell two-column">
      <div>
        <p class="eyebrow">Why mRNA</p>
        <h2>Why mature mRNA needs separate evaluation</h2>
      </div>
      <div class="prose">
        <p>
          Splicing joins selected exons into a transcript isoform, while
          regulatory information is distributed across the 5' UTR, coding
          sequence, splice architecture, and 3' UTR. These features affect
          transcript localization, persistence, and translation.
        </p>
        <p>
          Useful signals also appear at very different scales. An RNA-binding
          protein may recognize a short motif. The benchmark's SNV tasks alter
          one nucleotide at a time. Stability and translation can reflect
          effects accumulated across a complete transcript. The suite includes
          tasks spanning each of these scales.
        </p>
        <div class="transcript" aria-label="Schematic mature transcript with 5 prime UTR, coding sequence, and 3 prime UTR">
          <span class="transcript__utr">5' UTR</span>
          <span class="transcript__cds">coding sequence</span>
          <span class="transcript__utr transcript__utr--end">3' UTR</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-rule">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">The gap</p>
        <h2>Sources of variation in published model scores</h2>
      </div>
      <div class="gap-grid">
        {
          gaps.map((gap, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{gap.title}</h3>
              <p>{gap.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section design-section" id="design">
    <div class="shell two-column">
      <div>
        <p class="eyebrow">Benchmark design</p>
        <h2>Evaluation of frozen model representations</h2>
      </div>
      <div class="prose">
        <p>
          Models provide per-token or per-nucleotide representations. When a
          sequence exceeds a model's context limit, token-level representations
          from its chunks are concatenated along sequence position and then
          mean-pooled over the reconstructed sequence.
        </p>
        <p>
          Archived regression results use RidgeCV with internal cross-validation
          on the training partition; the current API defaults to ordinary least
          squares unless Ridge is selected. Binary tasks use logistic
          regression; multilabel tasks use a multi-output wrapper around
          logistic regression. These probes do not estimate the best result
          possible after end-to-end fine-tuning.
        </p>
        <p>
          UTR SNV tasks compare alternate and reference transcripts. The
          current package supports linear probes on sequences and paired
          embedding differences, unsigned L2 distances between pooled
          embeddings, and normalized log-likelihood differences for compatible
          models.
        </p>
        <dl class="method-list">
          <div>
            <dt>Inputs</dt>
            <dd>Endogenous transcripts or synthetic constructs, with codon-position and splice-site tracks supplied only to compatible adapters.</dd>
          </div>
          <div>
            <dt>Representations</dt>
            <dd>Frozen model embeddings, pooled over sequence position.</dd>
          </div>
          <div>
            <dt>Classification metric</dt>
            <dd>AUPRC, with micro-averaging for multilabel tasks. Paired SNV scoring also reports AUROC.</dd>
          </div>
          <div>
            <dt>Regression metric</dt>
            <dd>Pearson correlation.</dd>
          </div>
        </dl>
        <p class="method-caveat">
          AUPRC depends on class prevalence and should be interpreted within a
          dataset rather than compared directly across datasets.
        </p>
      </div>
    </div>

    <div class="shell task-scale">
      <p class="task-scale__note">
        Signal scale is a useful way to read the suite, not a claim that every
        assay is purely local or transcript-wide.
      </p>
      <article>
        <span>Local signal</span>
        <h3>Short motifs, constrained regions, and single-nucleotide variants</h3>
        <p>Transcript-level RNA-protein interactions, miRNA targeting, reporter 5' UTRs, and UTR SNV pathogenicity classification.</p>
      </article>
      <div class="task-scale__axis" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
      <article>
        <span>Transcript-wide outcome</span>
        <h3>Effects distributed across the mature transcript</h3>
        <p>RNA half-life, translation efficiency, localization, and transcript lifecycle.</p>
      </article>
    </div>
  </section>

  <section class="section section-rule" id="splits">
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Split design</p>
          <h2>Split strategies reduce sequence-related overlap</h2>
        </div>
        <p>
          mRNABench supports split strategies that reduce overlap under
          different definitions of sequence relatedness. Each dataset stores
          its default in metadata.
        </p>
      </div>
      <div class="split-table">
        <article>
          <span>01</span>
          <h3>Homology</h3>
          <p>Keeps every gene in a precomputed paralog group within the same split.</p>
        </article>
        <article>
          <span>02</span>
          <h3>k-mer</h3>
          <p>Clusters unnormalized raw k-mer counts before assigning groups to splits, so both motif counts and sequence length affect grouping.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Chromosome</h3>
          <p>Holds out complete chromosomes, while recognizing that homology can still cross chromosomes.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Random</h3>
          <p>Used for synthetic constructs and some matched-variant tasks where homology grouping conflicts with the dataset design.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section findings" id="findings">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Current development analysis</p>
        <h2>Qualified findings from the current manuscript</h2>
      </div>
      <div class="findings__grid">
        {
          findings.map((finding) => (
            <article>
              <h3>{finding.title}</h3>
              <p>{finding.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-rule" id="limits">
    <div class="shell two-column">
      <div>
        <p class="eyebrow">Limits</p>
        <h2>What the benchmark does not establish</h2>
      </div>
      <div class="limits-list">
        <p>
          <strong>Interpretation of linear probes.</strong> A strong probe score
          does not show that a representation contains a causal account of
          regulation or predict its fine-tuning performance.
        </p>
        <p>
          <strong>Pooling and long-sequence context.</strong> Mean pooling loses
          positional information. Chunking does not restore attention or other
          interactions across chunk boundaries.
        </p>
        <p>
          <strong>Label transformations.</strong> Binding sites become
          transcript-level interaction labels, continuous localization
          proportions become multilabel endpoints, and lifecycle measurements
          become compartment-specific depletion labels.
        </p>
        <p>
          <strong>Representative-transcript selection.</strong> Several
          datasets select one representative or principal transcript per gene,
          so the benchmark does not cover the full range of isoform-specific
          effects.
        </p>
        <p>
          <strong>Scope of uncertainty intervals.</strong> Intervals across
          split seeds reflect changes in split membership. They do not include
          model-training randomness, assay noise, or preprocessing uncertainty.
        </p>
        <p>
          <strong>Experimental context.</strong> Performance does not establish
          transfer across species, cell lines, tissues, assay platforms, or RNA
          chemistry. Synthetic constructs and endogenous transcripts also
          represent different input distributions.
        </p>
        <p>
          <strong>Mature-mRNA variant scope.</strong> UTR SNV classification in
          mature-transcript context cannot capture pathogenic mechanisms that
          act before splicing or outside the assayed transcript context.
        </p>
      </div>
    </div>
  </section>

  <section class="section citation" id="citation">
    <div class="shell citation__grid">
      <div>
        <p class="eyebrow">Cite mRNABench</p>
        <h2>bioRxiv v1 (2025)</h2>
        <p class="citation__authors">
          Ruian Shi, Taykhoom Dalal, Philip Fradkin, Divya Koyyalagunta,
          Simran Chhabria, Andrew Jung, Cyrus Tam, Defne Ceyhan, Jessica Lin,
          Kaitlin U. Laverty, Ilyes Baali, Bo Wang, and Quaid Morris.
        </p>
        <p>
          <a href={site.paper}>bioRxiv v1 DOI: 10.1101/2025.07.05.662870</a>
        </p>
        <a class="button button--quiet" href={withBase("/docs")}>Open documentation</a>
      </div>
      <CodeBlock code={bibtex} language="bibtex" label="BibTeX" />
    </div>
  </section>
</BaseLayout>

<style>
  .publication {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    padding-block: 2rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .publication__label {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    font-size: var(--text-xs);
  }

  .publication__label span {
    color: var(--ink-muted);
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .publication__label a {
    width: fit-content;
    font-weight: 620;
  }

  .publication__content h2 {
    max-width: 48rem;
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 2.1rem);
    font-weight: 580;
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .publication__authors {
    max-width: 62rem;
    margin: 1.2rem 0 0;
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: 1.8;
  }

  .publication__authors a,
  .publication__authors span {
    color: var(--ink);
  }

  .publication__authors a {
    text-decoration-color: var(--line-strong);
  }

  .publication__authors sup {
    margin-left: 0.12rem;
    color: var(--red-deep);
    font-size: 0.66em;
    font-weight: 650;
  }

  .publication__affiliations {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem 1.5rem;
    max-width: 62rem;
    margin: 1.2rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }

  .publication__affiliations li {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.35rem;
    color: var(--ink-muted);
    font-size: 0.75rem;
  }

  .publication__affiliations li span {
    color: var(--red-deep);
    font-weight: 680;
  }

  .publication__note {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    margin: 1rem 0 0;
    color: var(--ink-muted);
    font-size: var(--text-xs);
  }

  .publication__note a {
    font-weight: 620;
  }

  .overview-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.4rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .overview-nav span,
  .overview-nav a {
    font-size: var(--text-xs);
  }

  .overview-nav span {
    color: var(--ink-muted);
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .overview-nav a {
    color: var(--ink);
    text-decoration: none;
  }

  .overview-nav a:hover {
    color: var(--red-deep);
  }

  .two-column {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(3rem, 9vw, 9rem);
    align-items: start;
  }

  h2 {
    max-width: 15ch;
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 530;
    letter-spacing: -0.055em;
    line-height: 1.05;
  }

  .prose > p {
    max-width: 44rem;
    margin: 0 0 1.35rem;
    color: var(--ink-soft);
  }

  .transcript {
    display: grid;
    grid-template-columns: 0.8fr 3.4fr 1.2fr;
    align-items: center;
    margin-top: 3rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line-strong);
  }

  .transcript span {
    display: grid;
    min-height: 3rem;
    place-items: center;
    color: var(--ink);
    background: var(--paper-soft);
    border-top: 4px solid var(--ink-muted);
    font-size: var(--text-xs);
    font-weight: 620;
  }

  .transcript .transcript__cds {
    color: var(--on-red);
    background: var(--red);
    border-color: var(--red);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    gap: 2rem;
    align-items: start;
    margin-bottom: 3.5rem;
  }

  .section-heading h2 {
    max-width: 20ch;
  }

  .gap-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .gap-grid article {
    min-height: 17rem;
    padding: 1.35rem;
  }

  .gap-grid article + article {
    border-left: 1px solid var(--line-strong);
  }

  .gap-grid span,
  .split-table span {
    color: var(--red-deep);
    font-size: var(--text-xs);
    font-weight: 680;
  }

  .gap-grid h3 {
    margin: 4rem 0 0.8rem;
    font-size: var(--text-base);
    font-weight: 620;
  }

  .gap-grid p,
  .split-table p,
  .findings p {
    margin: 0;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .design-section {
    color: var(--white);
    background: var(--black);
  }

  .design-section h2 {
    color: var(--white);
  }

  .design-section .eyebrow {
    color: var(--red-on-dark);
  }

  .design-section .prose > p {
    color: var(--footer-muted);
  }

  .method-list {
    margin: 2.5rem 0 0;
    border-top: 1px solid var(--footer-line);
  }

  .method-list div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--footer-line);
  }

  .method-list dt {
    color: var(--red-on-dark);
    font-size: var(--text-xs);
    font-weight: 650;
  }

  .method-list dd {
    margin: 0;
    color: var(--footer-muted);
    font-size: var(--text-sm);
  }

  .method-caveat {
    margin-top: 1rem !important;
    color: var(--footer-muted) !important;
    font-size: var(--text-sm);
  }

  .task-scale {
    display: grid;
    grid-template-columns: 1fr 0.55fr 1fr;
    gap: 2rem;
    align-items: center;
    margin-top: clamp(5rem, 10vw, 10rem);
  }

  .task-scale__note {
    grid-column: 1 / -1;
    max-width: 42rem;
    margin: 0 0 0.5rem;
    color: var(--footer-muted);
    font-size: var(--text-sm);
  }

  .task-scale article {
    min-height: 15rem;
    padding: 1.4rem;
    border: 1px solid var(--footer-line);
  }

  .task-scale article > span {
    color: var(--red-on-dark);
    font-size: var(--text-xs);
    font-weight: 680;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .task-scale h3 {
    max-width: 18rem;
    margin: 3.2rem 0 0.8rem;
    font-size: var(--text-lg);
    font-weight: 540;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .task-scale p {
    margin: 0;
    color: var(--footer-muted);
    font-size: var(--text-sm);
  }

  .task-scale__axis {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }

  .task-scale__axis i {
    width: 0.42rem;
    height: var(--height, 2.2rem);
    background: var(--white);
    border-radius: 999px;
  }

  .task-scale__axis i:nth-child(2),
  .task-scale__axis i:nth-child(6) {
    --height: 3.8rem;
  }

  .task-scale__axis i:nth-child(3),
  .task-scale__axis i:nth-child(5) {
    --height: 5rem;
    background: var(--red-on-dark);
  }

  .task-scale__axis i:nth-child(4) {
    --height: 6rem;
  }

  .section-heading--split {
    grid-template-columns: 1fr 0.7fr;
  }

  .section-heading--split > p {
    max-width: 35rem;
    margin: 0;
    color: var(--ink-muted);
  }

  .split-table {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .split-table article {
    min-height: 15rem;
    padding: 1.35rem;
  }

  .split-table article + article {
    border-left: 1px solid var(--line-strong);
  }

  .split-table h3 {
    margin: 3rem 0 0.8rem;
    font-size: var(--text-lg);
    font-weight: 560;
  }

  .findings {
    background: var(--paper-soft);
  }

  .findings__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line-strong);
  }

  .findings article {
    min-height: 13rem;
    padding: 1.6rem 1.3rem;
    border-bottom: 1px solid var(--line-strong);
