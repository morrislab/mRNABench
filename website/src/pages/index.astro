---

<BaseLayout
  title="mRNABench | A benchmark for mRNA representation learning"
  description="Why mRNA needs its own benchmark, how mRNABench evaluates frozen representations, and how to interpret the results."
>
  <PageIntro
    eyebrow="Benchmark overview"
    title="A benchmark centered on mature-mRNA biology"
    lead="mRNABench evaluates linearly accessible information in frozen nucleotide-model representations across translation, stability, localization, molecular interactions, transcript lifecycle, and UTR SNV classification."
  />

  <section class="publication shell" aria-labelledby="publication-title">
    <div class="publication__label">
      <span>Public preprint</span>
      <a href={site.paper}>bioRxiv v1</a>
    </div>
    <div class="publication__content">
      <h2 id="publication-title">
        mRNABench: A curated benchmark for mature mRNA property and function
        prediction
      </h2>
      <p class="publication__authors">
        {
          paperAuthors.map((author, index) => (
            <>
              {author.url ? (
                <a href={author.url}>{author.name}</a>
              ) : (
                <span>{author.name}</span>
              )}
              <sup>
                {author.equalContribution && "†"}
                {author.affiliations.join(",")}
              </sup>
              {index < paperAuthors.length - 1 && ", "}
            </>
          ))
        }
      </p>
      <ol class="publication__affiliations">
        {
          paperAffiliations.map((affiliation, index) => (
            <li><span>{index + 1}</span>{affiliation}</li>
          ))
        }
      </ol>
      <p class="publication__note">
        <span>† Equal contribution</span>
        <a href={site.paper}>doi:10.1101/2025.07.05.662870</a>
      </p>
    </div>
  </section>

  <div class="overview-switcher" data-overview-switcher>
    <nav class="overview-nav shell" aria-label="Paper overview sections">
      <span>Explore</span>
      <div
        class="overview-nav__tabs"
        data-overview-tablist
      >
        <a
          id="tab-need"
          href="#need"
          data-overview-tab
        >Why mRNA</a>
        <a
          id="tab-gap"
          href="#gap"
          data-overview-tab
        >Comparison</a>
        <a
          id="tab-design"
          href="#design"
          data-overview-tab
        >Evaluation</a>
        <a
          id="tab-tasks"
          href="#tasks"
          data-overview-tab
        >Task scale</a>
        <a
          id="tab-splits"
          href="#splits"
          data-overview-tab
        >Splits</a>
        <a
          id="tab-findings"
          href="#findings"
          data-overview-tab
        >Findings</a>
        <a
          id="tab-limits"
          href="#limits"
          data-overview-tab
        >Limits</a>
      </div>
    </nav>

    <div class="overview-panels">
      <div
        class="overview-panel is-active"
        id="need"
        data-overview-panel
      >
        <section class="section">
          <div class="shell two-column">
            <div>
              <p class="eyebrow">Why mRNA</p>
              <h2>Why mature mRNA needs separate evaluation</h2>
            </div>
            <div class="prose">
              <p>
                Splicing joins selected exons into a transcript isoform, while
                regulatory information is distributed across the 5' UTR, coding
                sequence, splice architecture, and 3' UTR. These features affect
                transcript localization, persistence, and translation.
              </p>
              <p>
                Useful signals also appear at very different scales. An
                RNA-binding protein may recognize a short motif. The benchmark's
                SNV tasks alter one nucleotide at a time. Stability and
                translation can reflect effects accumulated across a complete
                transcript. The suite includes tasks spanning each of these
                scales.
              </p>
              <div
                class="transcript"
                role="img"
                aria-label="Schematic mature transcript with 5 prime UTR, coding sequence, and 3 prime UTR"
              >
                <span class="transcript__utr">5' UTR</span>
                <span class="transcript__cds">coding sequence</span>
                <span class="transcript__utr transcript__utr--end">3' UTR</span>
              </div>
            </div>
          </div>
        </section>

      </div>

  <section
    class="section section-rule overview-panel"
    id="gap"
    data-overview-panel
  >
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Comparison</p>
        <h2>What is held consistent across models</h2>
      </div>
      <div class="gap-grid">
        {
          gaps.map((gap, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{gap.title}</h3>
              <p>{gap.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section section-rule design-section overview-panel"
    id="design"
    data-overview-panel
  >
    <div class="shell two-column">
      <div>
        <p class="eyebrow">Evaluation</p>
        <h2>Frozen representations and linear probes</h2>
      </div>
      <div class="prose">
        <p>
          Models provide per-token or per-nucleotide representations. When a
          sequence exceeds a model's context limit, token-level representations
          from its chunks are concatenated along sequence position and then
          mean-pooled over the reconstructed sequence.
        </p>
        <p>
          Regression probes can use ordinary least squares or RidgeCV, with the
          Ridge penalty selected on the training partition. Binary tasks use
          logistic regression, and multilabel tasks fit one logistic model per
          label. The leaderboard uses Ridge; the Python API defaults to
          ordinary least squares.
        </p>
        <p>
          UTR SNV tasks compare alternate and reference transcripts. The
          mRNABench supports linear probes on sequences and paired
          embedding differences, unsigned L2 distances between pooled
          embeddings, and normalized log-likelihood differences for compatible
          models.
        </p>
        <dl class="method-list">
          <div>
            <dt>Inputs</dt>
            <dd>Endogenous transcripts or synthetic constructs, with codon-position and splice-site tracks supplied only to compatible adapters.</dd>
          </div>
          <div>
            <dt>Representations</dt>
            <dd>Frozen model embeddings, pooled over sequence position.</dd>
          </div>
          <div>
            <dt>Classification metric</dt>
            <dd>AUPRC, with micro-averaging for multilabel tasks. Paired SNV scoring also reports AUROC.</dd>
          </div>
          <div>
            <dt>Regression metric</dt>
            <dd>Pearson correlation.</dd>
          </div>
        </dl>
        <p class="method-caveat">
          AUPRC changes with the frequency of positive labels. Compare models
          within the same dataset rather than comparing raw AUPRC values across
          datasets.
        </p>
      </div>
    </div>
  </section>

  <section
    class="section section-rule overview-panel"
    id="tasks"
    data-overview-panel
  >
    <div class="shell two-column task-section__heading">
      <div>
        <p class="eyebrow">Task scale</p>
        <h2>From short motifs to whole-transcript outcomes</h2>
      </div>
      <div class="prose">
        <p>
          The suite spans sequence-local inputs and whole-transcript
          measurements. Interaction datasets use transcript-level labels even
          when the underlying assay detects local binding sites.
        </p>
      </div>
    </div>
    <div class="shell task-scale">
      <article>
        <span>Sequence-local inputs</span>
        <h3>Reporter regions and single-nucleotide changes</h3>
        <p>These tasks include reporter 5' UTRs and UTR variant classification.</p>
      </article>
      <div class="task-scale__axis" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i>
      </div>
      <article>
        <span>Transcript-wide measurements</span>
        <h3>Effects distributed across the mature transcript</h3>
        <p>RNA half-life, translation efficiency, localization, and transcript lifecycle.</p>
      </article>
    </div>
  </section>

  <section
    class="section section-rule overview-panel"
    id="splits"
    data-overview-panel
  >
    <div class="shell">
      <div class="section-heading section-heading--split">
        <div>
          <p class="eyebrow">Split design</p>
          <h2>Four ways to separate train and test data</h2>
        </div>
        <p>
          Each dataset uses a default split suited to its rows and labels. The
          dataset catalog lists that choice.
        </p>
      </div>
      <div class="split-table">
        <article>
          <span>01</span>
          <h3>Random</h3>
          <p>Assigns rows at random. This is used for synthetic constructs and matched variant sets when gene-level grouping does not fit the study design.</p>
        </article>
        <article>
          <span>02</span>
          <h3>k-mer</h3>
          <p>Clusters unnormalized raw k-mer counts before assigning groups to splits, so both motif counts and sequence length affect grouping.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Chromosome</h3>
          <p>Holds out complete chromosomes, while recognizing that homology can still cross chromosomes.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Homology</h3>
          <p>Keeps genes from the same precomputed paralog group in one split.</p>
        </article>
      </div>
    </div>
  </section>

  <section
    class="section section-rule findings overview-panel"
    id="findings"
    data-overview-panel
  >
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Findings</p>
        <h2>Results across models and evaluation settings</h2>
      </div>
      <div class="findings__grid">
        {
          findings.map((finding) => (
            <article>
              <h3>{finding.title}</h3>
              <p>{finding.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="section section-rule overview-panel"
    id="limits"
    data-overview-panel
  >
    <div class="shell two-column">
      <div>
        <p class="eyebrow">Limits</p>
        <h2>Limits of the benchmark</h2>
      </div>
      <div class="limits-list">
        <p>
          <strong>Linear probes.</strong> A high score means that a linear model
          can recover the label from the frozen embedding. It does not identify
          a regulatory mechanism or show how the full model will behave after
          fine-tuning.
        </p>
        <p>
          <strong>Long sequences.</strong> Mean pooling removes positional
          information. When a transcript is longer than a model's context
          window, chunking covers the full sequence, but tokens in different
          chunks do not interact.
        </p>
        <p>
          <strong>What the labels represent.</strong> Some source assays are
          more detailed than the benchmark target. For eCLIP and miRNA data, we
          ask whether a transcript has at least one recorded interaction.
          Localization proportions and lifecycle measurements are converted
          into compartment-level labels. These tasks test transcript-level
          prediction, not binding-site location or interaction strength.
        </p>
        <p>
          <strong>One transcript per gene.</strong> Some source studies provide
          a principal transcript or a gene-level measurement without
          isoform-resolved labels. We use one defined transcript so that each
          label maps to one sequence instead of copying the same measurement
          onto every isoform. Those tasks do not test isoform-specific
          regulation.
        </p>
        <p>
          <strong>Confidence intervals.</strong> The intervals come from
          rerunning the probe with different train, validation, and test
          assignments. They show sensitivity to the data split, not
          experimental noise or uncertainty introduced while processing the
          source data.
        </p>
        <p>
          <strong>Experimental setting.</strong> A score in one species, cell
          line, tissue, or assay does not guarantee the same performance in
          another. Synthetic reporter constructs and endogenous transcripts
          should also be treated as different settings.
        </p>
        <p>
          <strong>Variant scope.</strong> The UTR variant tasks score variants
          in mature-transcript sequence. They do not cover effects that occur
          before splicing or depend on genomic context outside that transcript.
        </p>
      </div>
    </div>
  </section>
    </div>
  </div>

  <section class="section citation" id="citation">
    <div class="shell citation__grid">
      <div>
        <p class="eyebrow">Cite mRNABench</p>
        <h2>bioRxiv v1 (2025)</h2>
        <p class="citation__authors">
          Ruian Shi, Taykhoom Dalal, Philip Fradkin, Divya Koyyalagunta,
          Simran Chhabria, Andrew Jung, Cyrus Tam, Defne Ceyhan, Jessica Lin,
          Kaitlin U. Laverty, Ilyes Baali, Bo Wang, and Quaid Morris.
        </p>
        <p>
          <a href={site.paper}>bioRxiv v1 DOI: 10.1101/2025.07.05.662870</a>
        </p>
        <a class="button button--quiet" href={withBase("/docs")}>Open documentation</a>
      </div>
      <CodeBlock code={bibtex} language="bibtex" label="BibTeX" />
    </div>
  </section>
</BaseLayout>

<script>
  function initializeOverviewSwitcher() {
    const switcher = document.querySelector<HTMLElement>(
      "[data-overview-switcher]",
    );
    if (!switcher || switcher.dataset.initialized === "true") return;

    const tabs = Array.from(
      switcher.querySelectorAll<HTMLAnchorElement>("[data-overview-tab]"),
    );
    const panels = Array.from(
      switcher.querySelectorAll<HTMLElement>("[data-overview-panel]"),
    );
    const tabList = switcher.querySelector<HTMLElement>(
      "[data-overview-tablist]",
    );
    tabList?.setAttribute("role", "tablist");
    tabList?.setAttribute("aria-label", "Paper overview sections");
    tabs.forEach((tab) => {
      const panelId = tab.hash.slice(1);
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panelId);
      tab.setAttribute("aria-selected", "false");
    });
    panels.forEach((panel) => {
      panel.setAttribute("role", "tabpanel");
      panel.setAttribute("aria-labelledby", `tab-${panel.id}`);
      panel.tabIndex = 0;
    });

    const panelIds = new Set(panels.map((panel) => panel.id));
    const firstPanelId = tabs[0]?.hash.slice(1);
    if (!firstPanelId) return;

    const activate = (panelId: string, updateUrl = false) => {
      if (!panelIds.has(panelId)) return;

      let selectedTab: HTMLAnchorElement | undefined;
      let selectedPanel: HTMLElement | undefined;
      tabs.forEach((tab) => {
        const selected = tab.getAttribute("aria-controls") === panelId;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected) selectedTab = tab;
      });
      panels.forEach((panel) => {
        const selected = panel.id === panelId;
        panel.classList.toggle("is-active", selected);
        panel.hidden = !selected;
        if (selected) selectedPanel = panel;
      });

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.hash = panelId;
        window.history.replaceState(window.history.state, "", url);
      }

      requestAnimationFrame(() => {
        selectedTab?.scrollIntoView({
          block: "nearest",
          inline: "center",
        });
        if (updateUrl) {
          selectedPanel?.scrollIntoView({
            block: "start",
          });
        }
      });
    };

    const requestedPanel = window.location.hash.slice(1);
    const initialPanel = panelIds.has(requestedPanel)
      ? requestedPanel
      : firstPanelId;
    activate(initialPanel);
    switcher.dataset.initialized = "true";

    tabs.forEach((tab) => {
      tab.addEventListener("click", (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }
        event.preventDefault();
        const panelId = tab.getAttribute("aria-controls");
        if (panelId) activate(panelId, true);
      });
    });

    tabList?.addEventListener("keydown", (event) => {
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        return;
      }
      const currentIndex = tabs.indexOf(
        document.activeElement as HTMLAnchorElement,
      );
      if (currentIndex < 0) return;

      event.preventDefault();
      let nextIndex = currentIndex;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = tabs.length - 1;
      if (event.key === "ArrowLeft") {
        nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
      }
      if (event.key === "ArrowRight") {
        nextIndex = (currentIndex + 1) % tabs.length;
      }

      const nextTab = tabs[nextIndex];
      const panelId = nextTab.getAttribute("aria-controls");
      if (panelId) activate(panelId, true);
      nextTab.focus();
    });

    window.addEventListener("hashchange", () => {
      const panelId = window.location.hash.slice(1);
      if (panelIds.has(panelId)) activate(panelId);
    });

    if (initialPanel !== firstPanelId) {
      requestAnimationFrame(() => {
        document.getElementById(initialPanel)?.scrollIntoView();
      });
    }
  }

  initializeOverviewSwitcher();
</script>

<style>
