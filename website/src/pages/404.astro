---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/site";
---

<BaseLayout title="Page not found | mRNABench" description="The requested mRNABench page could not be found.">
  <section class="not-found shell">
    <span>404</span>
    <div>
      <p class="eyebrow">Page not found</p>
      <h1>The requested page was not found.</h1>
      <p>The URL may be outdated, or the page may not be published.</p>
      <a class="button" href={withBase("/")}>Go to the mRNABench home page</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    grid-template-columns: 0.45fr 1fr;
    gap: clamp(2rem, 8vw, 8rem);
    align-items: start;
    min-height: 70vh;
    padding-block: clamp(5rem, 12vw, 11rem);
  }

  .not-found > span {
    color: var(--red);
    font-size: clamp(5rem, 15vw, 13rem);
    font-weight: 380;
    letter-spacing: -0.08em;
    line-height: 0.78;
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 530;
    letter-spacing: -0.055em;
    line-height: 1;
  }

  .not-found div > p:not(.eyebrow) {
    margin: 1.5rem 0 2rem;
    color: var(--ink-muted);
  }

  @media (max-width: 680px) {
    .not-found {
      grid-template-columns: 1fr;
    }
  }
</style>
