---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { site, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = site.title,
  description = site.description,
  image = withBase("/brand/mark-light.svg"),
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f5f1" data-theme-color />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/brand/favicon-light.svg")} media="(prefers-color-scheme: light)" />
    <link rel="icon" href={withBase("/brand/favicon-dark.svg")} media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const selected = localStorage.getItem("mrnabench-theme");
        if (selected === "light" || selected === "dark") {
          document.documentElement.dataset.theme = selected;
        }
      } catch (error) {
        console.warn("Unable to read the saved theme.", error);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
