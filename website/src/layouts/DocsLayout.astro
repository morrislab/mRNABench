---
import BaseLayout from "./BaseLayout.astro";
import { withBase } from "../lib/site";

interface Props {
  title: string;
  description: string;
  section: string;
}

const { title, description, section } = Astro.props;

const groups = [
  {
    title: "Start",
    links: [
      { href: "/docs", label: "Documentation home" },
      { href: "/docs/quickstart", label: "Quickstart" },
      { href: "/docs/concepts", label: "Core concepts" },
    ],
  },
  {
    title: "Run",
    links: [
      { href: "/docs/benchmarking", label: "Run a benchmark" },
      { href: "/docs/configuration", label: "Configuration" },
      { href: "/docs/results", label: "Results and analysis" },
    ],
  },
  {
    title: "Extend",
    links: [
      { href: "/docs/add-dataset", label: "Add a dataset" },
      { href: "/docs/add-model", label: "Add a model" },
      { href: "/docs/api", label: "API map" },
    ],
  },
];

const currentPath = Astro.url.pathname;

function isCurrentPath(href: string): boolean {
  return currentPath === withBase(href).replace(/\/$/, "");
}
---

<BaseLayout title={`${title} | mRNABench docs`} {description}>
  <div class="docs-shell shell">
    <nav class="docs-sidebar" aria-label="Documentation">
      <a class="docs-sidebar__home" href={withBase("/docs")}>mRNABench docs</a>
      {
        groups.map((group) => (
          <div class="docs-sidebar__group">
            <span>{group.title}</span>
            {group.links.map((link) => (
              <a
                class:list={[
                  { "docs-sidebar__active": isCurrentPath(link.href) },
                ]}
                href={withBase(link.href)}
                aria-current={isCurrentPath(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>
    <details class="docs-mobile-nav">
      <summary>{section}: {title}</summary>
      <nav aria-label="Documentation">
        {
          groups.map((group) => (
            <div>
              <strong>{group.title}</strong>
              {group.links.map((link) => (
                <a href={withBase(link.href)} aria-current={isCurrentPath(link.href) ? "page" : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>
    </details>
    <article class="docs-content" id="docs-article">
      <header class="docs-content__header">
        <p>{section}</p>
        <h1>{title}</h1>
        <span>{description}</span>
      </header>
      <div class="docs-prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .docs-shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    gap: clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .docs-sidebar {
    position: sticky;
    top: 6rem;
    display: grid;
    align-content: start;
    max-height: calc(100vh - 7rem);
    padding: 3rem 0;
    overflow-y: auto;
  }

  .docs-sidebar__home {
    margin-bottom: 2.2rem;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 650;
    text-decoration: none;
  }

  .docs-sidebar__group {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.7rem;
  }

  .docs-sidebar__group span {
    margin-bottom: 0.2rem;
    color: var(--ink-muted);
    font-size: 0.65rem;
    font-weight: 680;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .docs-sidebar__group a {
    padding: 0.18rem 0 0.18rem 0.75rem;
    color: var(--ink-muted);
    border-left: 1px solid var(--line-strong);
    font-size: 0.82rem;
    text-decoration: none;
  }

  .docs-sidebar__group a:hover,
  .docs-sidebar__group a.docs-sidebar__active {
    color: var(--ink);
    border-color: var(--red);
  }

  .docs-content {
    min-width: 0;
    padding: clamp(4rem, 8vw, 7rem) 0 8rem;
  }

  .docs-mobile-nav {
    display: none;
  }

  .docs-content__header {
    max-width: 48rem;
    margin-bottom: 4rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .docs-content__header p {
    margin: 0 0 1rem;
    color: var(--red-deep);
    font-size: var(--text-xs);
    font-weight: 680;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .docs-content__header h1 {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 520;
    letter-spacing: -0.045em;
    line-height: 0.98;
  }

  .docs-content__header span {
    display: block;
    max-width: 42rem;
    margin-top: 1.5rem;
    color: var(--ink-muted);
    font-size: var(--text-lg);
    line-height: 1.45;
  }

  .docs-prose {
    max-width: 52rem;
  }

  .docs-prose :global(h2) {
    margin: 4.5rem 0 1rem;
    padding-top: 1rem;
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1.1;
  }

  .docs-prose :global(h3) {
    margin: 2.8rem 0 0.7rem;
    font-size: 1.22rem;
    font-weight: 620;
    letter-spacing: -0.02em;
  }

  .docs-prose :global(p),
  .docs-prose :global(li) {
    color: var(--ink-soft);
  }

  .docs-prose :global(p) {
    margin: 0.8rem 0 1.2rem;
  }

  .docs-prose :global(ul),
  .docs-prose :global(ol) {
    display: grid;
    gap: 0.55rem;
    padding-left: 1.2rem;
  }

  .docs-prose :global(code:not(pre code)) {
    padding: 0.1em 0.32em;
    overflow-wrap: anywhere;
    color: var(--ink);
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 2px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 0.84em;
  }

  .docs-prose :global(table) {
    display: block;
    width: 100%;
    max-width: 100%;
    margin: 1.5rem 0 2rem;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .docs-prose :global(table:focus-visible) {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }

  .docs-prose :global(th),
  .docs-prose :global(td) {
    padding: 0.8rem 0.7rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid var(--line);
  }

  .docs-prose :global(th) {
    color: var(--ink-muted);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .docs-shell {
      grid-template-columns: 1fr;
    }

    .docs-sidebar {
      display: none;
    }

    .docs-mobile-nav {
      display: block;
      margin-top: 1.5rem;
      border-bottom: 1px solid var(--line-strong);
    }

    .docs-mobile-nav summary {
      padding: 0.9rem 0;
      cursor: pointer;
      font-size: var(--text-sm);
      font-weight: 620;
    }

    .docs-mobile-nav div {
      display: grid;
      gap: 0.35rem;
      padding: 0.75rem 0;
      border-top: 1px solid var(--line);
    }

    .docs-mobile-nav strong {
      color: var(--ink-muted);
      font-size: 0.65rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .docs-mobile-nav a {
      padding: 0.2rem 0;
      color: var(--ink-muted);
      font-size: 0.8rem;
      text-decoration: none;
    }

    .docs-mobile-nav a[aria-current="page"] {
      color: var(--red-deep);
    }

    .docs-content {
      padding-top: 2.5rem;
    }
  }
</style>
